    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "item",
          "settings": {
            "title": "When will I receive my order?",
            "content": "<p>We dispatch within 24 hours on working days. Delivery takes 3-6 days worldwide, tracked from the moment it leaves our warehouse.</p>"
          }
        },
        "f2": {
          "type": "item",
          "settings": {
            "title": "What is the quality of your jerseys like?",
            "content": "<p>Lightweight recycled performance mesh with the oversized basketball cut, heat-pressed stitched-look lettering and team wordmarks. Built like the jerseys worn on court — every one is checked by hand before it ships.</p>"
          }
        },
        "f3": {
          "type": "item",
          "settings": {
            "title": "Can I swap the size if it doesn't fit?",
            "content": "<p>Yes. You have 30 days to exchange any unworn jersey, and size swaps are free — even on personalised jerseys.</p>"
          }
        },
        "f4": {
          "type": "item",
          "settings": {
            "title": "Is name and number lettering really free?",
            "content": "<p>Yes. Add any name and number up to 12 characters at checkout and we letter it at no extra cost, in the correct font for that team.</p>"
          }
        },
        "f5": {
          "type": "item",
          "settings": {
            "title": "How does the \"buy 3, get 1 free\" offer work?",
            "content": "<p>Add four jerseys to your cart: you pay for three and the cheapest one is free. The discount is applied automatically at checkout.</p>"
          }
        },
        "f6": {
          "type": "item",
          "settings": {
            "title": "Is my payment secure?",
            "content": "<p>Every payment runs through Shopify's encrypted checkout. We never see or store your card details.</p>"
          }
        }
      },
