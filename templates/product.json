            "review_5_rating": 5,
            "review_5_size": "2XL",
            "review_5_fit": "True to size",
            "review_5_body": "<p>Finally a shop that carries my size without charging extra. The cut is long enough and the shoulders sit right.</p>",
            "review_5_helpful": 8,
            "review_6_author": "Brianna C.",
            "review_6_city": "Portland, OR",
            "review_6_flag": "🇺🇸",
