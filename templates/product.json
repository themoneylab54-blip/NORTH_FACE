            "review_6_rating": 5,
            "review_6_size": "M",
            "review_6_fit": "True to size",
            "review_6_body": "<p>Bought two during the bundle deal. Both arrived folded properly in sealed bags, no creases and no loose threads.</p>",
            "review_6_helpful": 13,
            "review_7_author": "Devin M.",
            "review_7_city": "Denver, CO",
            "review_7_flag": "🇺🇸",
