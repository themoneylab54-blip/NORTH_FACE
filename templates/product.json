            "review_7_rating": 4,
            "review_7_size": "L",
            "review_7_fit": "Runs small",
            "review_7_body": "<p>Fabric and print are excellent. Mine came a little tighter than expected, so the free size swap came in handy.</p>",
            "review_7_helpful": 5,
