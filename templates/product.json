    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "item",
          "settings": {
            "title": "When will I receive my order?",
            "content": "<p>We dispatch within 24 hours on working days. Delivery takes 3-6 days worldwide, tracked from the moment it leaves our warehouse.</p>"
          }
        },
        "f2": {
          "type": "item",
          "settings": {
            "title": "What is the quality of your jerseys like?",
            "content": "<p>Lightweight recycled performance mesh with the oversized basketball cut, heat-pressed stitched-look lettering and wordmarks. Every one is checked by hand before it ships.</p>"
          }
        },
        "f3": {
          "type": "item",
          "settings": {
            "title": "Can I swap the size if it doesn't fit?",
            "content": "<p>Yes. You have 30 days to exchange any unworn jersey, and size swaps are free — even on personalised jerseys.</p>"
          }
        },
        "f4": {
          "type": "item",
          "settings": {
            "title": "Which size should I choose?",
            "content": "<p>Basketball jerseys are cut long and loose. Our chart follows standard US sizing: size down for a fitted look, stay true to size for the classic on-court look.</p>"
          }
        },
        "f5": {
          "type": "item",
          "settings": {
            "title": "Can I personalise the jersey with my name and number?",
            "content": "<p>Yes, and it is free. Add any name up to 12 characters and a number at checkout and we letter it in the correct font for that team.</p>"
          }
        },
        "f6": {
          "type": "item",
          "settings": {
            "title": "How does the \"buy 3, get 1 free\" offer work?",
            "content": "<p>Add four jerseys to your cart: you pay for three and the cheapest one is free. The discount is applied automatically at checkout.</p>"
          }
        }
      },
