    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "item",
          "settings": {
            "title": "When will I receive my order?",
            "content": "<p>We dispatch within 24 hours on working days. Delivery takes 3-6 days, tracked from the moment your order leaves our warehouse.</p>"
          }
        },
        "f2": {
          "type": "item",
          "settings": {
            "title": "How warm is this jacket?",
            "content": "<p>Each jacket's fill, weight and temperature range are listed in its description. As a rule, the higher the fill power, the warmer the jacket for its weight.</p>"
          }
        },
        "f3": {
          "type": "item",
          "settings": {
            "title": "Which size should I choose?",
            "content": "<p>Our jackets have a regular fit with room for a mid-layer. Between two sizes, take the larger one if you layer heavily. Measurements for each size are in the size guide.</p>"
          }
        },
        "f4": {
          "type": "item",
          "settings": {
            "title": "Can I return or exchange my jacket?",
            "content": "<p>Yes. You have 30 days to return or exchange any unworn item with its tags.</p>"
          }
        },
        "f5": {
          "type": "item",
          "settings": {
            "title": "How do Black Friday prices work?",
            "content": "<p>The discount is already applied to the price shown on the product page, and the countdown shows exactly when the offer ends. When a discount code is mentioned, it is applied automatically at checkout.</p>"
          }
        },
        "f6": {
          "type": "item",
          "settings": {
            "title": "Is my payment secure?",
            "content": "<p>Every payment runs through Shopify's encrypted checkout. We never see or store your card details.</p>"
          }
        }
