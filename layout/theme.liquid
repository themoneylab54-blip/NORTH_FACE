<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">

    {%- comment -%}Time-based A/B switch between product templates: must run before anything else loads.{%- endcomment -%}
    {%- render 'ab-product-switch' -%}

    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}
    {%- render 'social-meta-tags' -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script>
      if (!(HTMLScriptElement.supports && HTMLScriptElement.supports('importmap'))) {
        const importMapPolyfill = document.createElement('script');
        importMapPolyfill.async = true;
        importMapPolyfill.src = "{{ 'es-module-shims.min.js' | asset_url }}";

        document.head.appendChild(importMapPolyfill);
      }
    </script>

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>


<!-- Basket Addict size-mapped checkout: 2026-09-23 -->
<style>.ba-checkout-note{font-size:12px;line-height:1.45;margin:8px 0;text-align:center;opacity:.8}.ba-checkout-error{color:#b42318;opacity:1}.shopify-payment-button,.additional-checkout-buttons,shopify-accelerated-checkout,shopify-accelerated-checkout-cart{display:none!important}</style>
<script>
(function () {
  'use strict';
  var destination = 'https://s3t0ib-gn.myshopify.com';
  var variants = {S:'52731694842154',M:'52731694874922',L:'52731694907690',XL:'52731694940458','2XL':'52731694973226','3XL':'52731697463594'};
  var busy = false;
  function sizeOf(item) {
    var options = item.options_with_values || [];
    var named = options.find(function(o){return /^(size|taille)$/i.test(o.name);});
    var candidates = named ? [named.value] : (item.variant_options || [item.variant_title]);
    for (var value of candidates) {
      var size = String(value || '').trim().toUpperCase().replace(/\s+/g,'');
      if (size === 'XXL') size = '2XL';
      if (size === 'XXXL') size = '3XL';
      if (variants[size]) return size;
    }
    throw new Error('Please contact us to check out this size: ' + (item.product_title || item.title));
  }
  function checkoutUrl(cart) {
    if (!cart.items || !cart.items.length) throw new Error('Your cart is empty. Please add a jersey first.');
    var quantities = {};
    var details = cart.items.map(function(item,index){
      var size = sizeOf(item), id = variants[size];
      if (!Number.isInteger(item.quantity) || item.quantity < 1) throw new Error('Please update your cart quantities and try again.');
      quantities[id] = (quantities[id] || 0) + item.quantity;
      var properties = Object.entries(item.properties || {}).filter(function(pair){return pair[1] !== null && pair[1] !== '';}).map(function(pair){return pair[0] + ': ' + String(pair[1]);}).join('; ');
      return (index + 1) + '. ' + (item.product_title || item.title) + ' | Size: ' + size + ' | Qty: ' + item.quantity + ' | Source variant: ' + item.variant_id + (item.sku ? ' | SKU: ' + item.sku : '') + (properties ? ' | ' + properties : '');
    });
    var url = new URL(destination + '/cart/' + Object.entries(quantities).map(function(pair){return pair[0]+':'+pair[1];}).join(','));
    url.searchParams.set('note', 'BASKET ADDICT — original jersey selections\n' + details.join('\n') + (cart.note ? '\nCustomer note: '+cart.note : ''));
    url.searchParams.set('attributes[Source store]', 'x3mszp-ad.myshopify.com');
    details.forEach(function(detail,index){url.searchParams.set('attributes[Jersey '+(index+1)+']',detail);});
    if (url.href.length > 16000) throw new Error('This order is too large for online checkout. Please contact us for help.');
    return url.href;
  }
  function notice(control, message, error) {
    var parent = control.parentElement;
    var note = parent.querySelector('.ba-checkout-note');
    if (!note) { note = document.createElement('p'); note.className = 'ba-checkout-note'; note.setAttribute('role','status'); parent.appendChild(note); }
    note.textContent = message;
    note.classList.toggle('ba-checkout-error', !!error);
  }
  async function redirect(control) {
    if (busy) return;
    busy = true;
    control.setAttribute('aria-busy','true');
    notice(control,'Opening secure checkout…');
    try {
      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var response = await fetch(root + 'cart.js', {credentials:'same-origin',cache:'no-store'});
      if (!response.ok) throw new Error('Unable to load your cart. Please try again.');
      var url = checkoutUrl(await response.json());
      window.location.assign(url);
    } catch (error) {
      notice(control,error.message || 'Unable to open checkout. Please try again.',true);
      busy = false;
      control.removeAttribute('aria-busy');
    }
  }
  function checkoutControl(target) {
    if (!(target instanceof Element)) return null;
    var control = target.closest('[name="checkout"],a[href]');
    if (!control) return null;
    if (control.getAttribute('name') === 'checkout') return control;
    try {var url = new URL(control.href, location.href);return url.origin === location.origin && /\/checkout\/?$/.test(url.pathname) ? control : null;} catch (_) {return null;}
  }
  document.addEventListener('click',function(event){
    var control = checkoutControl(event.target);
    if (!control) return;
    event.preventDefault(); event.stopImmediatePropagation(); redirect(control);
  },true);
  document.addEventListener('submit',function(event){
    var form = event.target;
    var control = event.submitter && checkoutControl(event.submitter);
    if (!control && form instanceof HTMLFormElement && /\/checkout\/?$/.test(new URL(form.action,location.href).pathname)) control = form;
    if (!control) return;
    event.preventDefault(); event.stopImmediatePropagation(); redirect(control);
  },true);
  function explainCheckout(){
    document.querySelectorAll('[name="checkout"]').forEach(function(control){
      if (control.dataset.baMappedCheckout) return;
      control.dataset.baMappedCheckout = 'true';
      notice(control,'Secure checkout at s3t0ib-gn.myshopify.com. Listed as Classic Basketball Jersey; your selected designs, sizes and personalization are included in the order details.');
    });
  }
  document.addEventListener('DOMContentLoaded',function(){
    explainCheckout();
    new MutationObserver(explainCheckout).observe(document.body,{childList:true,subtree:true});
  });
  window.addEventListener('pageshow',function(){busy=false;document.querySelectorAll('[name="checkout"][aria-busy]').forEach(function(el){el.removeAttribute('aria-busy');});});
})();
</script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    {{- 'reference-cards.css' | asset_url | stylesheet_tag -}}
    {{- 'cart-lines.css' | asset_url | stylesheet_tag -}}
  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
  </body>
</html>