{%- comment -%}
IMPLEMENTATION NOTE: Impact header with all the menu is an extremely complex piece of code. Due to requirements from design
team, we had to cover over hundred of potential combinations. As a consequence, this part (and all the menu snippets) are
extremely sensitive code that should (if possible) not be touched unless you have spend enough time to study and understand
the underlying logic of the menu.
{%- endcomment -%}

{%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
  {%- assign will_show_country_selector = true -%}
{%- endif -%}

{%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
  {%- assign will_show_locale_selector = true -%}
{%- endif -%}

{%- liquid
  comment
    Inline search (opt-in) and the two-row desktop layout (logo / search / icons on the first row, navigation on the second).
    The two-row layout is only activated for the "logo left, navigation center" layout when the inline search is on.
  endcomment
  assign inline_search_enabled = false
  if section.settings.show_inline_search and section.settings.layout != 'drawer'
    assign inline_search_enabled = true
  endif

  assign two_row_header = false
  if inline_search_enabled and section.settings.layout == 'logo_left_navigation_center'
    assign two_row_header = true
  endif

  assign nav_highlight_item = section.settings.nav_highlight_item | strip | downcase

  comment
    Team grid: the menu item(s) named in "team_menu_item" open a grid of team logos with a search field (the drawer
    part lives in snippets/navigation-panel.liquid, the markup in snippets/team-menu-grid.liquid).
  endcomment
  assign team_grid_enabled = false
  assign team_menu_names = ''
  if section.settings.team_collections != blank and section.settings.team_menu_item != blank
    assign team_grid_enabled = true
    assign team_menu_names = section.settings.team_menu_item | downcase | replace: ', ', ',' | replace: ' ,', ',' | strip | split: ','
  endif

  assign team_search_placeholder = section.settings.team_search_placeholder | default: 'Search a team'
  assign team_no_results_text = section.settings.team_no_results_text | default: 'No team found'

  assign typewriter_terms = ''
  if section.settings.search_placeholder_terms != blank
    assign typewriter_terms = section.settings.search_placeholder_terms | strip | replace: ',', '<br />' | newline_to_br | split: '<br />'
  endif
-%}

{%- capture nav_highlight_icon -%}
  <svg role="presentation" focusable="false" width="14" height="14" class="icon icon-trophy header__nav-highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
{%- endcapture -%}

<style>
  {%- comment -%}
    The theme only loads the regular and bold faces of the body font. The two-row navigation and the highlighted
    menu item use a medium (500) weight, so that face is emitted here when it is needed.
  {%- endcomment -%}
  {%- if two_row_header or nav_highlight_item != blank -%}
    {%- assign text_font_medium = settings.text_font | font_modify: 'weight', '500' -%}
    {%- if text_font_medium -%}
      {{ text_font_medium | font_face: font_display: 'fallback' }}
    {%- endif -%}
  {%- endif -%}

  :root {
    --sticky-header-enabled: {%- if section.settings.enable_sticky -%}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid-template: "main-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-3){% else %}var(--spacing-4-5){% endif %};
    --header-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
    --header-background-blur-radius: {{ section.settings.background_blur_radius }}px;
    --header-transparent-text-color: {{ section.settings.transparent_header_text_color.rgb }};

    {%- if section.settings.logo != blank -%}
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
      --header-logo-height: {{ section.settings.logo_mobile_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
    {%- endif -%}

    position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 10;
  }

  {%- if section.settings.enable_sticky -%}
    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.opening_from == 'left' -%}
    @media screen and (max-width: 699px) {
      .navigation-drawer {
        --drawer-content-max-height: calc(100vh - (var(--spacing-2) * 2));
      }
    }
  {%- endif -%}

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      {%- if section.settings.logo != blank -%}
        --header-logo-width: {{ section.settings.logo_max_width }}px;
        --header-logo-height: {{ section.settings.logo_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
      {%- endif -%}

      --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-6){% else %}var(--spacing-8-5){% endif %};
    }
  }

  {%- if section.settings.layout contains 'logo_left' -%}
    @media screen and (min-width: 1150px) {
      {%- if section.settings.secondary_menu != blank or will_show_country_selector or will_show_locale_selector -%}
        {%- assign max_percent = '55%' -%}
      {%- else -%}
        {%- assign max_percent = '70%' -%}
      {%- endif -%}

      #shopify-section-{{ section.id }} {
        --header-grid-template: "logo main-nav secondary-nav" / {% if section.settings.layout == 'logo_left_navigation_inline' %}auto minmax(0, 1fr) minmax(0, max-content){% else %}minmax(0, 1fr) fit-content({{ max_percent }}) minmax(0, 1fr){% endif %};
      }
    }
  {%- endif -%}

  .header__search-form {
    display: none;
  }

  header-search-typewriter {
    display: contents;
  }

  .header__nav-highlight-icon {
    flex-shrink: 0;
    color: var(--header-nav-highlight-icon-color, currentColor);
  }

  a.header__nav-item--highlight {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1-5, 6px);
  }

  {%- if inline_search_enabled -%}
    @media screen and (min-width: 1150px) {
      .header--inline-search .header__main-nav {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: var(--spacing-2-5, 10px);
      }

      /* Only holds the hamburger and the mobile search icon, both hidden at this width */
      .header--inline-search .header__main-nav > .header__icon-list {
        display: none;
      }

      .header__search-form {
        display: flex;
        align-items: center;
        gap: var(--spacing-3);
        width: 100%;
        max-width: var(--header-search-max-width, 640px);
        height: var(--header-search-height, 36px);
        padding-inline: var(--spacing-4);
        {%- comment -%}A white pill would disappear on a light header, so light headers get a light grey one{%- endcomment -%}
        {%- assign header_background_brightness = settings.header_background | color_brightness -%}
        background: {% if header_background_brightness > 200 %}#f2f2f2{% else %}#ffffff{% endif %};
        color: #121212;
        border-radius: 9999px;
      }

      .header__search-form svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      .header__search-input {
        flex: 1 1 auto;
        min-width: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: var(--text-sm, 14px);
        outline: none;
      }

      .header__search-input::placeholder {
        color: rgb(18 18 18 / .55);
      }

      .header__search-input::-webkit-search-cancel-button {
        -webkit-appearance: none;
      }
    }
  {%- endif -%}

  {%- if two_row_header -%}
    @media screen and (min-width: 1150px) {
      #shopify-section-{{ section.id }} {
        --header-padding-block: 15px;
        --header-nav-height: 44px;
        --header-two-row-logo-height: {{ section.settings.two_row_logo_height | default: 24 }}px;
        /* Own variable: theme.css redeclares --header-link-list-spacing on .header, which would win over the section value */
        --header-two-row-nav-gap: 22px;
      }

      /*
        Declared on the header element itself, not on the section: --header-part-gap only exists on .header. Declared
        higher up, var(--header-part-gap) is undefined, which invalidates the whole grid template and stacks the logo,
        search bar, menu and icons in a single cell.
        Gutter columns replace the wrapper's inline padding so the navigation row can span the full width.
      */
      #shopify-section-{{ section.id }} .header--two-row {
        --header-gutter-column: max(0px, max(var(--container-gutter), 50% - var(--container-max-width) / 2) - var(--header-part-gap));
        --header-grid-template: ". logo search secondary-nav ." "nav nav nav nav nav" / var(--header-gutter-column) minmax(0, 1fr) minmax(0, var(--header-search-max-width, 640px)) minmax(0, 1fr) var(--header-gutter-column);
      }

      .header--two-row .header__wrapper {
        padding-inline: 0;
        padding-block-end: 0;
        row-gap: 0;
      }

      .header--two-row .header__main-nav {
        display: contents;
      }

      .header--two-row .header__search-form {
        grid-area: search;
        justify-self: center;
      }

      .header--two-row .header__logo {
        grid-area: logo;
      }

      /* Row 1 logo: fixed height, width follows the image ratio instead of the "Image width" setting */
      .header--two-row .header__logo-image {
        height: var(--header-two-row-logo-height);
        width: auto;
        max-width: 100%;
        object-fit: contain;
        object-position: left center;
      }

      .header--two-row .header__secondary-nav {
        grid-area: secondary-nav;
      }

      .header--two-row .header__link-list--main {
        grid-area: nav;
        justify-content: center;
        align-items: center;
        gap: var(--spacing-3) var(--header-two-row-nav-gap, 22px);
        min-height: var(--header-nav-height);
        margin-block-start: var(--header-padding-block);
        padding-inline: var(--container-gutter);
        border-block-start: 1px solid rgb(var(--text-color) / .1);
        font-size: 12px;
        line-height: 1.2;
      }

      .header--two-row .header__link-list--main > ul > li > :is(a, button, details > summary) {
        font-weight: 400;
        color: rgb(var(--text-color) / .85);
      }

      .header--two-row .header__link-list--main > ul > li > :is(a[aria-current="page"], .header__nav-item--highlight) {
        font-weight: 500;
        color: rgb(var(--text-color));
      }

      .header--two-row .header__link-list--main .text-with-icon {
        gap: var(--spacing-1-5, 6px);
      }

      .header--two-row .header__link-list--main .icon-chevron-bottom {
        top: 0;
      }
    }
  {%- endif -%}

  /* Mobile menu drawer extras, markup in snippets/drawer-menu-extras.liquid */
  .drawer-menu {
    gap: var(--spacing-6);
  }

  .drawer-menu__search {
    display: flex;
    align-items: center;
    gap: var(--spacing-2-5);
    height: 44px;
    padding-inline: var(--spacing-4);
    border-radius: 9999px;
    background: rgb(var(--text-color) / .06);
    color: rgb(var(--text-color) / .6);
  }

  .drawer-menu__search input[type="search"] {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgb(var(--text-color));
    font: inherit;
    font-size: 16px; /* 16px or more keeps iOS from zooming in on focus */
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .drawer-menu__search input[type="search"]::placeholder {
    color: rgb(var(--text-color) / .55);
  }

  .drawer-menu__search:focus-within {
    box-shadow: 0 0 0 2px rgb(var(--text-color) / .25);
  }

  .drawer-menu__teams {
    display: grid;
    gap: var(--spacing-3);
  }

  .drawer-menu__label {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--text-color) / .6);
  }

  .drawer-menu__team-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 64px;
    gap: var(--spacing-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer-menu__team {
    display: grid;
    justify-items: center;
    gap: var(--spacing-1-5);
    text-align: center;
  }

  .drawer-menu__team-logo {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgb(var(--text-color) / .05);
    transition: background-color .2s ease;
  }

  .drawer-menu__team:hover .drawer-menu__team-logo {
    background: rgb(var(--text-color) / .1);
  }

  .drawer-menu__team-logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .drawer-menu__team-initial {
    font-size: 18px;
    font-weight: bold;
  }

  .drawer-menu__team-name {
    max-width: 100%;
    overflow: hidden;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer-menu__offer {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    border-radius: 12px;
    background: #111111;
    color: #ffffff;
  }

  .drawer-menu__offer-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffd014;
    color: #111111;
  }

  .drawer-menu__offer-text {
    display: grid;
    flex: 1 1 auto;
    gap: 2px;
    min-width: 0;
  }

  .drawer-menu__offer-title {
    font-size: 15px;
    font-weight: bold;
    line-height: 1.3;
    letter-spacing: .02em;
    text-transform: uppercase;
  }

  .drawer-menu__offer-subtitle {
    font-size: 13px;
    line-height: 1.4;
    opacity: .75;
  }

  .drawer-menu__help-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .drawer-menu__help-list a {
    color: rgb(var(--text-color) / .7);
    transition: color .2s ease;
  }

  .drawer-menu__help-list a:hover {
    color: rgb(var(--text-color));
  }

  {%- if section.settings.drawer_compact_links -%}
    /* Mobile menu: compact rows with separators instead of large headings (every level of the menu drawer) */
    #header-sidebar-menu .navigation-drawer__main-links,
    #header-sidebar-menu .panel + .panel .panel__wrapper > ul.v-stack {
      gap: 0;
    }

    #header-sidebar-menu .panel + .panel .panel__wrapper > ul.v-stack > li:first-child {
      margin-block-end: var(--spacing-2);
    }

    #header-sidebar-menu .panel li.h3 {
      font-family: var(--text-font-family);
      font-size: 17px;
      font-style: normal;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: normal;
      text-transform: none;
      border-block-end: 1px solid rgb(var(--text-color) / .08);
    }

    #header-sidebar-menu .panel li.h3 > :is(a, button) {
      padding-block: 14px;
    }
  {%- endif -%}

  {%- if team_grid_enabled -%}
    /* Team grid (mobile menu drawer + desktop mega menu), markup in snippets/team-menu-grid.liquid */
    .team-menu-grid {
      display: grid;
      gap: var(--spacing-4);
      font-size: var(--text-sm, 14px);
      line-height: 1.4;
    }

    .team-menu-grid__head {
      display: grid;
      gap: var(--spacing-3);
    }

    .team-menu-grid__title {
      margin: 0;
    }

    .team-menu-grid__search {
      display: flex;
      align-items: center;
      gap: var(--spacing-2-5);
      height: 44px;
      padding-inline: var(--spacing-4);
      border-radius: 9999px;
      background: rgb(var(--text-color) / .06);
      color: rgb(var(--text-color) / .6);
      cursor: text;
    }

    .team-menu-grid__search svg {
      flex-shrink: 0;
    }

    .team-menu-grid__search input {
      flex: 1 1 auto;
      min-width: 0;
      height: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: rgb(var(--text-color));
      font: inherit;
      font-size: 16px; /* 16px or more keeps iOS from zooming in on focus */
      outline: none;
      -webkit-appearance: none;
      appearance: none;
    }

    .team-menu-grid__search input::placeholder {
      color: rgb(var(--text-color) / .55);
    }

    .team-menu-grid__search:focus-within {
      box-shadow: 0 0 0 2px rgb(var(--text-color) / .25);
    }

    .team-menu-grid__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .team-menu-grid__card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-2);
      height: 100%;
      padding: var(--spacing-4) var(--spacing-1-5) var(--spacing-3);
      border-radius: 10px;
      background: rgb(var(--text-color) / .045);
      color: rgb(var(--text-color));
      text-align: center;
      transition: background-color .2s ease;
    }

    .team-menu-grid__card:hover,
    .team-menu-grid__card:focus-visible {
      background: rgb(var(--text-color) / .09);
    }

    .team-menu-grid__logo {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }

    .team-menu-grid__logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .team-menu-grid__initials {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: rgb(var(--text-color) / .1);
      font-size: 15px;
      font-weight: bold;
    }

    .team-menu-grid__name {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      font-size: 12.5px;
      font-weight: 500;
      line-height: 1.25;
    }

    .team-menu-grid__empty {
      margin: 0;
      color: rgb(var(--text-color) / .65);
      text-align: center;
    }

    .team-menu-grid__all {
      justify-self: center;
      font-weight: bold;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .team-mega-menu {
      display: block;
    }

    .team-menu-grid--mega {
      max-width: 1180px;
      margin-inline: auto;
    }

    .team-menu-grid--mega .team-menu-grid__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
      align-items: center;
    }

    .team-menu-grid--mega .team-menu-grid__search {
      height: 40px;
    }

    .team-menu-grid--mega .team-menu-grid__search input {
      font-size: 14px;
    }

    .team-menu-grid--mega .team-menu-grid__list {
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }

    .team-menu-grid--mega .team-menu-grid__logo {
      width: 40px;
      height: 40px;
    }

    .team-menu-grid--mega .team-menu-grid__name {
      font-size: 12px;
    }
  {%- endif -%}
</style>

<height-observer variable="header">
  <store-header class="header{% if inline_search_enabled %} header--inline-search{% endif %}{% if two_row_header %} header--two-row{% endif %}" {% if section.settings.hide_on_scroll %}hide-on-scroll="100"{% endif %} {% if section.settings.enable_sticky %}sticky{% endif %}>
    <div class="header__wrapper">
      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      MAIN NAV AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="header__main-nav">
        <div class="header__icon-list">
          <button type="button" class="tap-area {% if section.settings.layout != 'drawer' %}lg:hidden{% endif %}" aria-controls="header-sidebar-menu">
            <span class="sr-only">{{ 'header.general.menu' | t }}</span>
            {%- render 'icon' with 'hamburger' -%}
          </button>

          <a href="{{ routes.search_url }}" class="tap-area sm:hidden" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.search' | t }}</span>
            {%- render 'icon' with 'search' -%}
          </a>
        </div>

        {%- if inline_search_enabled -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <input type="hidden" name="type" value="product">
            {%- render 'icon' with 'search', width: 18, height: 18 -%}
            <header-search-typewriter {% if typewriter_terms != '' %}terms="{{ typewriter_terms | json | escape }}" prefix="{{ section.settings.search_placeholder_prefix | escape }}"{% endif %}>
              <input type="search" name="q" class="header__search-input" placeholder="{{ section.settings.inline_search_placeholder | escape }}" aria-label="{{ 'header.general.search' | t }}" autocomplete="off">
            </header-search-typewriter>
          </form>
        {%- endif -%}

        {%- if section.settings.layout != 'drawer' and section.settings.menu.links.size > 0 -%}
          <nav class="header__link-list header__link-list--main {% if section.settings.layout == 'logo_left_navigation_center' %}justify-center{% endif %} wrap" role="navigation">
              <ul class="contents" role="list">
                {%- for link in section.settings.menu.links -%}
                  {% liquid
                    assign link_title_downcase = link.title | strip | downcase
                    assign mega_menu_block = ''
                    assign is_highlighted_link = false

                    if nav_highlight_item != blank and link_title_downcase == nav_highlight_item
                      assign is_highlighted_link = true
                    endif

                    assign is_team_link = false
                    if team_menu_names contains link_title_downcase
                      assign is_team_link = true
                    endif

                    for block in section.blocks
                      assign menu_item_downcase = block.settings.menu_item | strip | downcase

                      if menu_item_downcase == link_title_downcase
                        assign mega_menu_block = block
                        break
                      endif

                    endfor
                  %}

                  <li>
                    {%- if is_team_link -%}
                      <details is="mega-menu-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}">
                        <summary class="text-with-icon gap-2.5 bold link-faded-reverse{% if is_highlighted_link %} header__nav-item--highlight{% endif %}" {% if link.url != '#' %}data-url="{{ link.url | escape }}"{% endif %}>
                          {% if is_highlighted_link %}{{ nav_highlight_icon }}{% endif %}{{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                        </summary>

                        <div class="mega-menu team-mega-menu">
                          {%- render 'team-menu-grid',
                            teams: section.settings.team_collections,
                            strip_text: section.settings.team_strip_text,
                            context: 'mega',
                            title: section.settings.team_grid_title,
                            search_placeholder: team_search_placeholder,
                            no_results_text: team_no_results_text,
                            view_all_url: link.url,
                            view_all_text: section.settings.team_view_all_text
                          -%}
                        </div>
                      </details>
                    {%- elsif link.levels == 0 and mega_menu_block == '' -%}
                      <a href="{{ link.url }}" class="bold link-faded-reverse{% if is_highlighted_link %} header__nav-item--highlight{% endif %}" {% if link.current %}aria-current="page"{% endif %}>{% if is_highlighted_link %}{{ nav_highlight_icon }}{% endif %}{{- link.title -}}</a>
                    {%- else -%}
                      {%- if mega_menu_block != '' -%}
                        {%- comment -%}
                        Implementation note: the designers had the desire to show a lot of different kind of menus in Impact: one standard
                        mega menu but also a kind of "sidebar" mode when the mega-menu appears in a drawer. Unfortunately, this comes with
                        a lot of extra complexity as we have to go through two different code path: a "details" element for the standard
                        menu, and a full drawer for the other one.
                        {%- endcomment -%}
                        {%- unless mega_menu_block.settings.layout == 'drawer' -%}
                          <details is="mega-menu-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}" {{ mega_menu_block.shopify_attributes }}>
                            <summary class="text-with-icon gap-2.5 bold link-faded-reverse{% if is_highlighted_link %} header__nav-item--highlight{% endif %}" {% if link.url != '#' %}data-url="{{ link.url | escape }}"{% endif %}>
                              {% if is_highlighted_link %}{{ nav_highlight_icon }}{% endif %}{{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                            </summary>

                           {%- render 'mega-menu-horizontal', link: link, mega_menu_block: mega_menu_block -%}
                          </details>
                        {%- else -%}
                          <button aria-controls="navigation-drawer-{{ forloop.index }}" aria-expanded="false" class="text-with-icon gap-2.5 bold link-faded-reverse{% if is_highlighted_link %} header__nav-item--highlight{% endif %}">
                            {% if is_highlighted_link %}{{ nav_highlight_icon }}{% endif %}{{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                          </button>

                          <navigation-drawer class="navigation-drawer drawer lg-max:hidden" id="navigation-drawer-{{ forloop.index }}" open-from="left" mega-menu>
                            {%- render 'navigation-panel', navigation_layout: section.settings.layout, main_menu: link, is_mega_menu: true, mega_menu_block: mega_menu_block -%}
                          </navigation-drawer>
                        {%- endunless -%}
                      {%- else -%}
                        <details class="relative" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}">
                          <summary class="text-with-icon gap-2.5 bold link-faded-reverse{% if is_highlighted_link %} header__nav-item--highlight{% endif %}" {% if link.url != '#' %}data-url="{{ link.url | escape }}"{% endif %}>
                            {% if is_highlighted_link %}{{ nav_highlight_icon }}{% endif %}{{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                          </summary>

                          <div class="dropdown-menu {% if link.levels <= 1 %}dropdown-menu--restrictable{% endif %}">
                            <ul class="contents" role="list">
                              {%- for sub_link in link.links -%}
                                <li>
                                  {%- if sub_link.levels == 0 -%}
                                    <a href="{{ sub_link.url }}" class="dropdown-menu__item group" {% if sub_link.current %}aria-current="page"{% endif %}>
                                      <span><span class="reversed-link">{{ sub_link.title }}</span></span>
                                    </a>
                                  {%- else -%}
                                    <details class="relative" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}">
                                      <summary class="dropdown-menu__item group" {% if sub_link.url != '#' %}data-url="{{ sub_link.url | escape }}"{% endif %}>
                                        <span><span class="reversed-link">{{- sub_link.title -}}</span></span>
                                        {%- render 'icon' with 'chevron-right' -%}
                                      </summary>

                                      <div class="dropdown-menu">
                                        <ul class="contents" role="list">
                                          {%- for sub_sub_link in sub_link.links -%}
                                            <li>
                                              <a href="{{ sub_sub_link.url }}" class="dropdown-menu__item group" {% if sub_sub_link.current %}aria-current="page"{% endif %}>
                                                <span><span class="reversed-link">{{ sub_sub_link.title }}</span></span>
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </details>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </details>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
          </nav>
        {%- endif -%}
      </div>

      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- capture logo_content -%}
        {%- if section.settings.logo -%}
          {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
          {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}
          <span class="sr-only">{{ shop.name }}</span>
          {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image' -}}

          {%- if section.settings.transparent_logo -%}
            {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text h4">{{ shop.name }}</span>
        {%- endif -%}
      {%- endcapture -%}

      {%- if request.page_type == 'index' -%}
        <h1 class="header__logo">
          <a href="{{ routes.root_url }}">{{ logo_content }}</a>
        </h1>
      {% else %}
        <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
      {% endif %}

      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      SECONDARY NAV AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="header__secondary-nav">
        {%- if section.settings.header != 'drawer' and section.settings.secondary_menu.links.size > 0 -%}
          <nav class="header__link-list" role="navigation">
            <ul class="contents">
              {%- for link in section.settings.secondary_menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="bold link-faded-reverse">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <ul class="header__icon-list">
          {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
            <li class="hidden md:block shrink-0">
              {%- render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, popover_vertical_position: 'end' -%}
            </li>
          {%- endif -%}

          {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
            <li class="hidden md:block shrink-0">
              {%- render 'localization-selector', type: 'locale', popover_vertical_position: 'end' -%}
            </li>
          {%- endif -%}

          <li{% if two_row_header %} class="lg:hidden"{% endif %}>
            <a href="{{ routes.search_url }}" class="hidden tap-area sm:block" aria-controls="search-drawer">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>
              {%- render 'icon' with 'search' -%}
            </a>
          </li>
          
          {%- if shop.customer_accounts_enabled -%}
            <li>
              <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hidden tap-area sm:block">
                <span class="sr-only">{% if customer %}{{ 'header.general.account' | t }}{% else %}{{ 'header.general.login' | t }}{% endif %}</span>
                {%- render 'icon' with 'account' -%}
              </a>
            </li>
          {%- endif -%}

          <li>
            <a href="{{ routes.cart_url }}" data-no-instant class="relative block tap-area" {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %}>
              <span class="sr-only">{{ 'header.general.cart' | t }}</span>
              {%- render 'icon' with 'cart' -%}

              <div class="header__cart-count">
                <cart-count class="count-bubble {% if cart.item_count == 0 %}opacity-0{% endif %}">
                  <span class="sr-only">{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                </cart-count>
              </div>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </store-header>
</height-observer>

