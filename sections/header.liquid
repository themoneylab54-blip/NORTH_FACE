{%- if inline_search_enabled and typewriter_terms != '' -%}
  <script>
    (function () {
      if (window.customElements.get('header-search-typewriter')) {
        return;
      }

      /* typewriter-frames:start */
      /**
       * Pure function: builds the frame sequence of the animated placeholder.
       * Each frame is { text, delay } where delay is how long (ms) the frame stays visible before the next one.
       * For every term: type it one character at a time (typeMs), hold the full "prefix term…" (holdMs),
       * then delete it one character at a time (deleteMs) back to the bare prefix, and move to the next term.
       */
      function typewriterFrames(terms, options) {
        options = options || {};

        var prefix = (options.prefix === undefined || options.prefix === null ? 'Search' : String(options.prefix)).trim();
        var ellipsis = options.ellipsis === undefined || options.ellipsis === null ? '\u2026' : String(options.ellipsis);
        var typeMs = options.typeMs > 0 ? options.typeMs : 60;
        var holdMs = options.holdMs > 0 ? options.holdMs : 1400;
        var deleteMs = options.deleteMs > 0 ? options.deleteMs : 30;
        var base = prefix === '' ? '' : prefix + ' ';
        var frames = [];

        (Array.isArray(terms) ? terms : []).forEach(function (term) {
          var chars = Array.from(String(term === undefined || term === null ? '' : term).trim());

          if (chars.length === 0) {
            return;
          }

          for (var i = 1; i <= chars.length; i++) {
            frames.push({ text: base + chars.slice(0, i).join(''), delay: typeMs });
          }

          frames.push({ text: base + chars.join('') + ellipsis, delay: holdMs });

          for (var j = chars.length - 1; j >= 0; j--) {
            frames.push({ text: base + chars.slice(0, j).join(''), delay: deleteMs });
          }
        });

        return frames;
      }
      /* typewriter-frames:end */

      class HeaderSearchTypewriter extends HTMLElement {
        connectedCallback() {
          this.input = this.querySelector('input');

          if (!this.input) {
            return;
          }

          let terms = [];

          try {
            terms = JSON.parse(this.getAttribute('terms') || '[]');
          } catch (error) {
            terms = [];
          }

          this.frames = typewriterFrames(terms, { prefix: this.getAttribute('prefix') });

          if (this.frames.length === 0) {
            return;
          }

          this.frameIndex = 0;
          this.staticPlaceholder = this.input.getAttribute('placeholder') || '';
          this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
          this.onMotionChange = () => (this.reducedMotion.matches ? this.stop() : this.start());
          this.onFocus = () => this.stop();
          this.onBlur = () => this.start();
          this.onVisibility = () => (document.hidden ? this.stop() : this.start());

          this.reducedMotion.addEventListener('change', this.onMotionChange);
          this.input.addEventListener('focus', this.onFocus);
          this.input.addEventListener('blur', this.onBlur);
          document.addEventListener('visibilitychange', this.onVisibility);

          this.onMotionChange();
        }

        disconnectedCallback() {
          this.stop();

          if (this.reducedMotion) {
            this.reducedMotion.removeEventListener('change', this.onMotionChange);
            this.input.removeEventListener('focus', this.onFocus);
            this.input.removeEventListener('blur', this.onBlur);
            document.removeEventListener('visibilitychange', this.onVisibility);
          }
        }

        start() {
          if (this.timer || this.reducedMotion.matches || document.hidden || document.activeElement === this.input || this.input.value !== '') {
            return;
          }

          this.tick();
        }

        tick() {
          const frame = this.frames[this.frameIndex % this.frames.length];

          this.input.setAttribute('placeholder', frame.text);
          this.frameIndex = (this.frameIndex + 1) % this.frames.length;
          this.timer = setTimeout(() => this.tick(), frame.delay);
        }

        stop() {
          clearTimeout(this.timer);
          this.timer = null;

          // A static placeholder is shown whenever the animation is not running (reduced motion, focus, hidden tab)
          this.input.setAttribute('placeholder', this.staticPlaceholder);
        }
      }

      window.HeaderSearchTypewriter = { frames: typewriterFrames };
      window.customElements.define('header-search-typewriter', HeaderSearchTypewriter);
    })();
  </script>
{%- endif -%}

{%- if team_grid_enabled -%}
  <script>
    (function () {
      if (window.customElements.get('team-menu-grid')) {
        return;
      }

      /* Filters the team cards while typing: a team matches when its name, or a word of it, starts with the query */
      class TeamMenuGrid extends HTMLElement {
        connectedCallback() {
          this.input = this.querySelector('[data-team-search]');
          this.items = Array.from(this.querySelectorAll('[data-team-name]'));
          this.empty = this.querySelector('[data-team-empty]');

          if (!this.input) {
            return;
          }

          this.input.addEventListener('input', () => this.filter());
          this.input.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter') {
              return;
            }

            event.preventDefault();
            const firstMatch = this.items.find((item) => !item.hidden);
            const link = firstMatch && firstMatch.querySelector('a');

            if (link) {
              window.location.href = link.href;
            }
          });

          /* Start from the full list next time the menu opens */
          const container = this.closest('navigation-drawer, details');

          if (container) {
            container.addEventListener(container.tagName === 'DETAILS' ? 'toggle' : 'dialog:after-hide', () => {
              if (container.tagName !== 'DETAILS' || !container.hasAttribute('open')) {
                this.reset();
              }
            });
          }
        }

        filter() {
          const query = this.input.value.trim().toLowerCase();
          let visibleCount = 0;

          this.items.forEach((item) => {
            const name = item.getAttribute('data-team-name');
            const matches = query === '' || name.startsWith(query) || name.split(' ').some((word) => word.startsWith(query)) || (query.includes(' ') && name.includes(query));

            item.hidden = !matches;
            visibleCount += matches ? 1 : 0;
          });

          if (this.empty) {
            this.empty.hidden = visibleCount > 0;
          }
        }

        reset() {
          if (this.input.value !== '') {
            this.input.value = '';
            this.filter();
          }
        }
      }

      window.customElements.define('team-menu-grid', TeamMenuGrid);
    })();
  </script>
{%- endif -%}

