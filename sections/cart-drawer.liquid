<script>
  // Cart timer: one end time per cart (kept in localStorage with the cart token, so it carries on across pages and a
  // new cart starts fresh), started when the cart gets its first item. At zero the cart is really emptied: the text
  // says what happens, and it happens. The drawer then shows the empty cart.
  if (!window.customElements.get('cart-reserve-timer')) {
    window.customElements.define('cart-reserve-timer', class extends HTMLElement {
      connectedCallback() {
        this.storageKey = 'cart-timer';
        this.token = this.getAttribute('cart-token') || '';
        this.minutes = Math.max(1, parseInt(this.getAttribute('minutes'), 10) || 5);
        this.textElement = this.querySelector('[data-timer-text]');
        this.template = this.textElement.getAttribute('data-template');

        if (!this.read()) {
          this.write(Date.now() + this.minutes * 60000);
        }

        // Cart emptied by the shopper: the next first item starts a new countdown.
        this.onCartChange = (event) => {
          if (event.detail?.cart?.item_count === 0) this.write(0);
        };
        document.addEventListener('cart:change', this.onCartChange);

        this.tick();
        this.interval = setInterval(() => this.tick(), 1000);
      }

      disconnectedCallback() {
        clearInterval(this.interval);
        document.removeEventListener('cart:change', this.onCartChange);
      }

      read() {
        try {
          const saved = JSON.parse(window.localStorage.getItem(this.storageKey) || 'null');
          return saved && saved.token === this.token ? saved.expiresAt : 0;
        } catch (error) {
          return this.memory || 0;
        }
      }

      write(expiresAt) {
        this.memory = expiresAt;
        try {
          if (expiresAt) {
            window.localStorage.setItem(this.storageKey, JSON.stringify({ token: this.token, expiresAt }));
          } else {
            window.localStorage.removeItem(this.storageKey);
          }
        } catch (error) {}
      }

      tick() {
        const expiresAt = this.read();

        // Emptied in another tab: nothing left to count.
        if (!expiresAt) {
          clearInterval(this.interval);
          this.style.display = 'none';
          return;
        }

        const secondsLeft = Math.ceil((expiresAt - Date.now()) / 1000);

        if (secondsLeft <= 0) {
          this.expire();
          return;
        }

        const formatted = String(Math.floor(secondsLeft / 60)).padStart(2, '0') + ':' + String(secondsLeft % 60).padStart(2, '0');
        this.textElement.textContent = this.template.replace('[temps]', formatted).replace('[time]', formatted);
      }

      async expire() {
        clearInterval(this.interval);
        this.write(0);

        try {
          await fetch(`${window.Shopify?.routes?.root || '/'}cart/clear.js`, { method: 'POST', headers: { 'Accept': 'application/json' } });
        } catch (error) {}

        if (this.hasAttribute('reload-on-expire')) {
          window.location.reload();
          return;
        }

        // Cart count, drawer content and every cart-aware element reload from the server.
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      }
    });
  }

  if (!window.customElements.get('cart-discount-form')) {
    window.customElements.define('cart-discount-form', class extends HTMLElement {
      connectedCallback() {
        this.querySelector('form').addEventListener('submit', async (event) => {
          event.preventDefault();

          const input = this.querySelector('input[name="discount"]');
          const message = this.querySelector('[data-discount-message]');
          const code = input.value.trim();

          if (!code) {
            return;
          }

          try {
            const response = await fetch(window.Shopify.routes.root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ discount: code })
            });
            const cart = await response.json();
            const applied = (cart.discount_codes || []).find((entry) => entry.code.toLowerCase() === code.toLowerCase());

            if (applied && applied.applicable) {
              message.textContent = message.getAttribute('data-success-text');
              message.hidden = false;
              document.dispatchEvent(new CustomEvent('cart:refresh'));
            } else {
              message.textContent = message.getAttribute('data-error-text');
              message.hidden = false;
            }
          } catch (error) {
            message.textContent = message.getAttribute('data-error-text');
            message.hidden = false;
          }
        });
      }
    });
  }
</script>

