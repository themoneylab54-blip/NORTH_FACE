<cart-drawer {% if request.design_mode %}handle-section-events{% endif %} class="cart-drawer drawer drawer--lg" id="cart-drawer">
  {%- if cart.item_count == 0 -%}
    <button is="close-button" aria-label="{{ 'general.accessibility.close' | t | escape }}">
      {%- render 'icon' with 'close' -%}
    </button>

    <div class="empty-state align-self-center">
      <div class="empty-state__icon-wrapper">
        {%- render 'icon' with 'cart', width: 32, height: 32, stroke_width: 1 -%}
        <span class="count-bubble count-bubble--lg">0</span>
      </div>

      <div class="prose">
        <p class="h5">{{ 'cart.general.empty' | t }}</p>

        {%- assign button_content = 'cart.general.continue_shopping' | t -%}
        {%- render 'button', href: settings.cart_empty_button_link, size: 'xl', content: button_content -%}
      </div>
    </div>
  {%- else -%}
    <div class="cart-drawer__inner">
      <div class="cart-drawer__top">
        <div class="h-stack items-center justify-between">
          <div class="h-stack grow gap-2 sm:gap-2.5">
            <p class="h5">{{- 'cart.general.title' | t -}}</p>
            <cart-count class="count-bubble count-bubble--md">{{ cart.item_count }}</cart-count>
          </div>

          {%- comment -%}Social proof block set to "Next to the cart title": compact, it takes no room in the cart content{%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'social_proof' and block.settings.position == 'header' and block.settings.text != blank -%}
              <div class="cart-drawer__header-rating" {% if block.settings.text_color.alpha != 0 and block.settings.text_color != blank %}style="color: {{ block.settings.text_color }};"{% endif %} {{ block.shopify_attributes }}>
                {%- if block.settings.style == 'stars' -%}
                  {%- assign sp_rating = block.settings.rating | default: 5 | round -%}
                  <span class="rating" aria-hidden="true" style="--star-color: {{ block.settings.stars_color.rgb | default: '13 165 88' }};">
                    {%- for i in (1..5) -%}
                      {%- if i <= sp_rating -%}
                        {%- render 'icon' with 'rating-star', width: 12, height: 12, class: 'rating__star rating__star--full' -%}
                      {%- else -%}
                        {%- render 'icon' with 'rating-star', width: 12, height: 12, class: 'rating__star rating__star--empty' -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- elsif block.settings.icon != 'none' -%}
                  <span aria-hidden="true">{%- render 'icon' with block.settings.icon, width: 14, height: 14 -%}</span>
                {%- endif -%}
                <span class="cart-drawer__header-rating-text">{{ block.settings.text | escape }}</span>
              </div>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          <button type="button" is="close-button" class="drawer__close-icon">
            <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
            {%- render 'icon' with 'close' -%}
          </button>
        </div>

        {%- if settings.cart_show_free_shipping_threshold -%}
          {%- render 'free-shipping-bar' -%}
        {%- endif -%}

        {%- assign top_block_types = 'offer_gauge,progress_goals,social_proof,timer' | split: ',' -%}
        {%- for block in section.blocks -%}
          {%- unless top_block_types contains block.type -%}{%- continue -%}{%- endunless -%}

          {%- case block.type -%}
            {%- when 'offer_gauge' -%}
              {%- render 'cart-offer-gauge', block: block -%}

            {%- when 'progress_goals' -%}
              {%- liquid
                assign goals_total = 0

                for line_item in cart.items
                  if line_item.requires_shipping
                    assign goals_total = goals_total | plus: line_item.final_line_price
                  endif
                endfor

                for discount_application in cart.cart_level_discount_applications
                  assign goals_total = goals_total | minus: discount_application.total_allocated_amount
                endfor

                assign goal1_cents = block.settings.goal1_amount | times: 100.0
                assign goal2_cents = block.settings.goal2_amount | times: 100.0
                assign track_max = goal1_cents

                if block.settings.goal2_enabled and goal2_cents > goal1_cents
                  assign track_max = goal2_cents
                endif

                assign free_shipping_unlocked = block.settings.free_shipping_unlocked | default: false, allow_false: true
                assign display_total = goals_total

                if free_shipping_unlocked and display_total < goal1_cents
                  assign display_total = goal1_cents
                endif

                assign progress = display_total | divided_by: track_max | at_most: 1.0

                capture goal_reached_icon
                  if block.settings.unlocked_icon != blank and block.settings.unlocked_icon != 'none'
                    echo '<span class="cart-drawer__goal-icon" aria-hidden="true">'
                    render 'icon' with block.settings.unlocked_icon, width: 16, height: 16
                    echo '</span>'
                  endif
                endcapture
              -%}

              {%- if cart.requires_shipping and goal1_cents > 0 -%}
                <div class="v-stack gap-2 cart-drawer__progress-goals" {{ block.shopify_attributes }}>
                  <p class="text-sm text-center">
                    {%- if free_shipping_unlocked -%}
                      {%- if block.settings.goal2_enabled and goal2_cents > goal1_cents and goals_total >= goal2_cents -%}
                        {{- goal_reached_icon -}}{{- block.settings.text_all_reached -}}
                      {%- else -%}
                        {{- goal_reached_icon -}}<strong>{{- block.settings.unlocked_text | default: block.settings.text_all_reached -}}</strong>

                        {%- if block.settings.goal2_enabled and goal2_cents > goal1_cents -%}
                          {%- assign remaining = goal2_cents | minus: goals_total | round | money -%}
                          <br><span class="text-subdued">{{- block.settings.goal2_text_unreached | replace: '[montant]', remaining | replace: '[amount]', remaining -}}</span>
                        {%- endif -%}
                      {%- endif -%}
                    {%- elsif goals_total < goal1_cents -%}
                      {%- assign remaining = goal1_cents | minus: goals_total | round | money -%}
                      {{- block.settings.goal1_text_unreached | replace: '[montant]', remaining | replace: '[amount]', remaining -}}
                    {%- elsif block.settings.goal2_enabled and goal2_cents > goal1_cents and goals_total < goal2_cents -%}
                      {%- assign remaining = goal2_cents | minus: goals_total | round | money -%}
                      {{- block.settings.goal2_text_unreached | replace: '[montant]', remaining | replace: '[amount]', remaining -}}
                    {%- else -%}
                      {{- goal_reached_icon -}}{{- block.settings.text_all_reached -}}
                    {%- endif -%}
                  </p>

                  <div style="position: relative; padding-block-end: 4px;">
                    <progress-bar class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress | times: 100 | round }}" style="--progress: {{ progress }}"></progress-bar>

                    {%- if block.settings.goal2_enabled and goal2_cents > goal1_cents -%}
                      {%- assign goal1_position = goal1_cents | divided_by: track_max | times: 100 | round -%}
                      <span aria-hidden="true" style="position: absolute; top: 50%; left: {{ goal1_position }}%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: var(--rounded-full); background: rgb(var(--background)); box-shadow: 0 0 0 1px rgb(var(--text-color) / .15); font-size: 13px; line-height: 1;">{%- if block.settings.goal1_icon != blank and block.settings.goal1_icon != 'none' -%}{%- render 'icon' with block.settings.goal1_icon, width: 14, height: 14 -%}{%- else -%}{{ block.settings.goal1_emoji | default: '🚚' }}{%- endif -%}</span>
                      <span aria-hidden="true" style="position: absolute; top: 50%; left: 100%; transform: translate(-100%, -50%); display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: var(--rounded-full); background: rgb(var(--background)); box-shadow: 0 0 0 1px rgb(var(--text-color) / .15); font-size: 13px; line-height: 1;">{%- if block.settings.goal2_icon != blank and block.settings.goal2_icon != 'none' -%}{%- render 'icon' with block.settings.goal2_icon, width: 14, height: 14 -%}{%- else -%}{{ block.settings.goal2_emoji | default: '🎁' }}{%- endif -%}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'social_proof' -%}
              {%- if block.settings.text != blank and block.settings.position != 'header' -%}
                {%- liquid
                  assign sp_background = 'rgb(var(--text-color) / .04)'
                  if block.settings.background.alpha != 0 and block.settings.background != blank
                    assign sp_background = block.settings.background
                  endif

                  assign sp_border = 'rgb(var(--text-color) / .08)'
                  if block.settings.border_color.alpha != 0 and block.settings.border_color != blank
                    assign sp_border = block.settings.border_color
                  endif
                -%}

                <div class="{% if block.settings.layout == 'stacked' %}v-stack gap-1 justify-items-center text-center{% else %}h-stack gap-2 justify-center{% endif %} text-sm" style="align-items: center; background: {{ sp_background }}; border: 1px solid {{ sp_border }}; {% if block.settings.text_color.alpha != 0 and block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %} padding: var(--spacing-3) var(--spacing-4); border-radius: {{ block.settings.radius | default: 12 }}px;" {{ block.shopify_attributes }}>
                  {%- if block.settings.style == 'stars' -%}
                    {%- assign sp_rating = block.settings.rating | default: 5 | round -%}
                    <div class="rating">
                      <div class="rating__stars" role="img" aria-label="{{ block.settings.text | escape }}" style="--star-color: {{ block.settings.stars_color.rgb | default: '13 165 88' }};">
                        {%- for i in (1..5) -%}
                          {%- if i <= sp_rating -%}
                            {%- render 'icon' with 'rating-star', class: 'rating__star rating__star--full' -%}
                          {%- else -%}
                            {%- render 'icon' with 'rating-star', class: 'rating__star rating__star--empty' -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- elsif block.settings.icon != 'none' -%}
                    {%- render 'icon' with block.settings.icon, width: 18, height: 18 -%}
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                </div>
              {%- endif -%}

            {%- when 'timer' -%}
              {%- if block.settings.text != blank -%}
                {%- liquid
                  assign timer_background = 'rgb(var(--text-color) / .04)'
                  if block.settings.background.alpha != 0 and block.settings.background != blank
                    assign timer_background = block.settings.background
                  endif

                  assign timer_border = 'rgb(var(--text-color) / .08)'
                  if block.settings.border_color.alpha != 0 and block.settings.border_color != blank
                    assign timer_border = block.settings.border_color
                  endif

                  capture initial_time
                    echo block.settings.minutes | append: ':00'
                  endcapture
                -%}

                {%- liquid
                  assign timer_full = block.settings.full_width | default: false, allow_false: true
                  assign timer_radius = block.settings.radius | default: 12 | append: 'px'
                  if timer_full
                    assign timer_radius = '0'
                  endif
                -%}

                <cart-reserve-timer minutes="{{ block.settings.minutes }}" cart-token="{{ cart.token | escape }}" {% if request.page_type == 'cart' %}reload-on-expire{% endif %} class="h-stack gap-2 justify-center text-sm{% if timer_full %} cart-reserve-timer--full{% endif %}" style="align-items: center; background: {{ timer_background }}; border: 1px solid {{ timer_border }}; {% if block.settings.text_color.alpha != 0 and block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %} padding: var(--spacing-3) var(--spacing-4); border-radius: {{ timer_radius }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                    <span class="cart-drawer__timer-icon" aria-hidden="true">{%- render 'icon' with block.settings.icon, width: 18, height: 18 -%}</span>
                  {%- elsif block.settings.emoji != blank -%}
                    <span aria-hidden="true">{{ block.settings.emoji | escape }}</span>
                  {%- endif -%}
                  <span data-timer-text data-template="{{ block.settings.text | escape }}">{{ block.settings.text | replace: '[temps]', initial_time | replace: '[time]', initial_time | escape }}</span>
                </cart-reserve-timer>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="v-stack gap-6 sm:gap-8">
        <div class="cart-drawer__line-items">
          {%- for line_item in cart.items -%}
            {%- render 'line-item', line_item: line_item, show_desktop_quantity: true, show_savings: section.settings.show_savings, show_compare_at: section.settings.savings_include_compare_at -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.products.count > 0 -%}
          <div class="cart-drawer__recommendations">
            <div class="v-stack gap-2.5 sm:gap-4">
              {%- capture carousel_id -%}cart-drawer-recommendations{%- endcapture -%}

              {%- liquid
                assign horizontal_products_blends = true
                assign product_card_background = section.settings.product_card_background | default: product.settings.product_card_background

                if product_card_background != 'rgba(0,0,0,0)' and product_card_background != blank and product_card_background != settings.dialog_background
                  assign horizontal_products_blends = false
                endif

                assign rendered_recommendations = 0

                capture recommendations
                  for recommended_product in section.settings.products
                    assign item_count_in_cart = cart | line_items_for: recommended_product

                    if item_count_in_cart.size == 0
                      render 'horizontal-product', product: recommended_product, show_add_to_cart: true, background: section.settings.product_card_background, text_color: section.settings.product_card_text_color
                      assign rendered_recommendations = rendered_recommendations | plus: 1
                    endif
                  endfor
                endcapture
              -%}

              {%- if rendered_recommendations > 0 -%}
                <div class="h-stack justify-between gap-4">
                  {%- if section.settings.recommendations_title != blank -%}
                    <p>{{ section.settings.recommendations_title | escape }}</p>
                  {%- endif -%}

                  {%- if rendered_recommendations > 1 -%}
                    <div class="h-stack gap-2 hidden sm:flex">
                      <button is="prev-button" class="circle-chevron hover:colors" aria-controls="{{ carousel_id }}" aria-label="{{ 'general.accessibility.previous' | t | escape }}" disabled>{%- render 'icon' with 'chevron-left-small', direction_aware: true -%}</button>
                      <button is="next-button" class="circle-chevron hover:colors" aria-controls="{{ carousel_id }}" aria-label="{{ 'general.accessibility.next' | t | escape }}">{%- render 'icon' with 'chevron-right-small', direction_aware: true -%}</button>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if recommendations != blank -%}
                <scroll-carousel selector=".horizontal-product" id="{{ carousel_id }}" class="horizontal-product-list-carousel {% unless horizontal_products_blends %}separate{% endunless %} scroll-area bleed">
                  <div class="horizontal-product-list {% if horizontal_products_blends %}divide-x{% else %}separate{% endif %}">
                    {{- recommendations -}}
                  </div>
                </scroll-carousel>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="v-stack gap-4 sm:gap-6" slot="footer">
      <div class="v-stack gap-1">
        {% for discount_application in cart.cart_level_discount_applications %}
          <div class="h-stack gap-4 justify-between">
            <div class="badge">
              {%- render 'icon' with 'discount' -%} {{- discount_application.title -}}
            </div>

            <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
          </div>
        {% endfor %}

        {%- if section.settings.show_savings -%}
          {%- render 'cart-savings', include_compare_at: section.settings.savings_include_compare_at -%}
        {%- endif -%}

        <div class="h-stack gap-4 justify-between">
          <span class="h5">{{ 'cart.general.total' | t }}</span>
          <span class="h5">{{- cart.total_price | money_with_currency -}}</span>
        </div>

        {%- if section.settings.show_shipping_text -%}
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>
          {%- elsif cart.taxes_included -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}</p>
          {%- elsif shop.shipping_policy.body != blank -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}</p>
          {%- else -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_cart_note -%}
          <button type="button" class="justify-self-start" aria-controls="cart-drawer-note">
            <span class="link text-sm text-subdued">
              {%- if cart.note == blank -%}
                {{- 'cart.general.add_order_note' | t -}}
              {%- else -%}
                {{- 'cart.general.edit_order_note' | t -}}
              {%- endif -%}
            </span>
          </button>

          <cart-note-dialog id="cart-drawer-note" class="cart-drawer__note">
            <div class="cart-drawer__note-inner">
              <div class="v-stack gap-4 sm:gap-6">
                <p class="h5">{{ 'cart.general.order_note' | t }}</p>

                <cart-note class="v-stack gap-4">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign order_save_label = 'cart.general.save_note' | t -%}

                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note -%}

                  <div class="justify-self-start">
                    {%- render 'button', type: 'button', content: order_save_label, size: 'lg', is: 'close-button', secondary: true -%}
                  </div>
                </cart-note>
              </div>
            </div>
          </cart-note-dialog>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'discount_code' -%}
          <cart-discount-form {{ block.shopify_attributes }}>
            <form class="h-stack gap-2">
              <input type="text" class="input grow" style="min-width: 0; padding-block: var(--spacing-2-5); padding-inline: var(--spacing-4); border: 1px solid rgb(var(--text-color) / .15); border-radius: var(--rounded-input, var(--rounded-sm)); background: transparent;" name="discount" placeholder="{{ block.settings.placeholder | default: 'Code promo' | escape }}" autocomplete="off" aria-label="{{ block.settings.placeholder | default: 'Code promo' | escape }}">
              {%- assign apply_label = block.settings.button_text | default: 'Appliquer' -%}
              {%- render 'button', type: 'submit', content: apply_label, size: 'lg', secondary: true -%}
            </form>
            <p class="text-sm" data-discount-message hidden style="margin-block-start: var(--spacing-2);" data-success-text="{{ block.settings.success_text | default: 'Code appliqué !' | escape }}" data-error-text="{{ block.settings.error_text | default: 'Ce code n’est pas valide.' | escape }}"></p>
          </cart-discount-form>
        {%- endif -%}
      {%- endfor -%}

      <form action="{{ routes.cart_url }}" method="POST" class="buy-buttons {% if section.settings.show_checkout_button %}buy-buttons--compact{% endif %}">
        {%- assign checkout_label = 'cart.general.checkout' | t -%}

        {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
          <a href="{{ routes.cart_url }}" class="button button--xl {% if section.settings.show_checkout_button %}button--secondary{% endif %}" data-no-instant>
            {{- 'cart.general.view_cart' | t -}}
          </a>
        {%- endif -%}

        {%- if section.settings.show_checkout_button -%}
          {%- render 'button', type: 'submit', content: checkout_label, icon: 'picto-lock', name: 'checkout', size: 'xl' -%}
        {%- endif -%}
      </form>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'guarantee' -%}
            {%- if block.settings.title != blank or block.settings.text != blank -%}
              {%- liquid
                assign guarantee_styles = ''

                if block.settings.background.alpha != 0 and block.settings.background != blank
                  assign guarantee_styles = guarantee_styles | append: 'background: ' | append: block.settings.background | append: '; padding: var(--spacing-3) var(--spacing-4);'
                endif

                if block.settings.border_color.alpha != 0 and block.settings.border_color != blank
                  assign guarantee_styles = guarantee_styles | append: ' border: 1px solid ' | append: block.settings.border_color | append: '; padding: var(--spacing-3) var(--spacing-4);'
                endif

                if block.settings.text_color.alpha != 0 and block.settings.text_color != blank
                  assign guarantee_styles = guarantee_styles | append: ' color: ' | append: block.settings.text_color | append: ';'
                endif
              -%}

              {%- if block.settings.style == 'compact' -%}
                {%- assign guarantee_label = block.settings.title | default: block.settings.text -%}
                <p class="cart-drawer__guarantee-compact text-sm" style="border-radius: {{ block.settings.radius | default: 12 }}px; {{ guarantee_styles }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != 'none' -%}
                    <span class="cart-drawer__guarantee-icon" style="{% if block.settings.icon_color.alpha != 0 and block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% endif %}" aria-hidden="true">
                      {%- render 'icon' with block.settings.icon, width: 18, height: 18 -%}
                    </span>
                  {%- endif -%}
                  <span class="bold">{{ guarantee_label | escape }}</span>
                </p>
              {%- else -%}
              <div class="{% if block.settings.alignment == 'center' %}v-stack gap-1 justify-items-center text-center{% else %}h-stack gap-3{% endif %}" style="align-items: center; border-radius: {{ block.settings.radius | default: 12 }}px; {{ guarantee_styles }}" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}
                  <span style="{% if block.settings.icon_color.alpha != 0 and block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% endif %} display: inline-flex;">
                    {%- render 'icon' with block.settings.icon, width: 26, height: 26 -%}
                  </span>
                {%- endif -%}
                <div class="v-stack gap-0.5">
                  {%- if block.settings.title != blank -%}<p class="text-sm bold">{{ block.settings.title | escape }}</p>{%- endif -%}
                  {%- if block.settings.text != blank -%}<p class="text-sm {% unless block.settings.text_color.alpha != 0 and block.settings.text_color != blank %}text-subdued{% endunless %}">{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
              </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'payment_icons' -%}
            <div class="v-stack gap-2" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <p class="text-sm text-subdued text-center">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              <div class="h-stack gap-1 justify-center cart-drawer__payment-icons">
                {%- render 'payment-icon-list', source: block.settings.icons_source, list: block.settings.icons_list, icon_class: 'payment-icon' -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</cart-drawer>

<style>
  #shopify-section-{{ section.id }} .cart-drawer__timer-icon,
  #shopify-section-{{ section.id }} .cart-drawer__goal-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cart-drawer__goal-icon {
    margin-inline-end: var(--spacing-1-5);
    vertical-align: -3px;
    color: rgb(var(--success-text));
  }

  /* Compact rating next to the cart title */
  #shopify-section-{{ section.id }} .cart-drawer__header-rating {
    display: grid;
    flex: 0 1 auto;
    justify-items: end;
    gap: 3px;
    min-width: 0;
    margin-inline: var(--spacing-3);
    font-size: 12px;
    line-height: 1.2;
    text-align: end;
  }

  #shopify-section-{{ section.id }} .cart-drawer__header-rating .rating {
    gap: 2px;
  }

