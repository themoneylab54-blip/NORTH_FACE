{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
TEAM SELECTOR
----------------------------------------------------------------------------------------------------------------------

A swipeable row of round team logos with the team name underneath. Each item links to its collection.

* The logo is the collection image (Products > Collections > team > Image). A collection without an image shows the
  team initials instead.
* The name is the collection title without the text set in "Text removed from names" ("Jerseys" by default, so
  "Atlanta Hawks Jerseys" reads "Atlanta Hawks").
* Mobile: the row bleeds to the screen edges and is swiped. Desktop: arrows appear when the row overflows.
{%- endcomment -%}

{%- liquid
  assign ts_collections = section.settings.collections
  assign ts_strip = section.settings.strip_text | strip
  assign ts_mobile = section.settings.circle_size_mobile | default: 64
  assign ts_desktop = section.settings.circle_size_desktop | default: 76
  assign ts_logo_scale = section.settings.logo_scale | default: 70
  assign ts_circle_bg = section.settings.circle_background
  assign ts_show_arrows = section.settings.show_arrows | default: true, allow_false: true
  assign ts_name_desktop = ts_desktop | plus: 16
  assign ts_name_mobile = ts_mobile | plus: 14
-%}

<style>
  #shopify-section-{{ section.id }} .team-selector {
    --ts-circle: {{ ts_mobile }}px;
    --ts-item: {{ ts_name_mobile }}px;
    --ts-logo: {{ ts_logo_scale }}%;
    --ts-circle-bg: {% if ts_circle_bg != blank and ts_circle_bg.alpha != 0 %}{{ ts_circle_bg }}{% else %}rgb(var(--text-color) / .06){% endif %};
    --ts-circle-border: {% if section.settings.circle_border != blank and section.settings.circle_border.alpha != 0 %}{{ section.settings.circle_border }}{% else %}transparent{% endif %};
    position: relative;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {%- if section.settings.background != blank and section.settings.background.alpha != 0 %}
      background: {{ section.settings.background }};
    {%- endif %}
    {%- if section.settings.text_color != blank and section.settings.text_color.alpha != 0 %}
      color: {{ section.settings.text_color }};
    {%- endif %}
  }

  #shopify-section-{{ section.id }} .team-selector__title {
    margin-block-end: 12px;
  }

  #shopify-section-{{ section.id }} .team-selector__track {
    display: flex;
    gap: 12px;
    margin-block: 0;
    list-style: none;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
  }

  #shopify-section-{{ section.id }} .team-selector__item {
    flex: 0 0 var(--ts-item);
    scroll-snap-align: start;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .team-selector__link {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .team-selector__logo {
    display: grid;
    place-items: center;
    width: var(--ts-circle);
    height: var(--ts-circle);
    border-radius: 50%;
    background: var(--ts-circle-bg);
    box-shadow: inset 0 0 0 1px var(--ts-circle-border);
    overflow: hidden;
    transition: transform .2s ease;
  }

  #shopify-section-{{ section.id }} .team-selector__logo img {
    width: var(--ts-logo);
    height: var(--ts-logo);
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .team-selector__initials {
    font-size: calc(var(--ts-circle) * .28);
    font-weight: 700;
    letter-spacing: .02em;
  }

  #shopify-section-{{ section.id }} .team-selector__name {
    font-size: 13px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .team-selector__arrow {
    display: none;
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .team-selector__link:hover .team-selector__logo {
      transform: scale(1.06);
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .team-selector {
      --ts-circle: {{ ts_desktop }}px;
      --ts-item: {{ ts_name_desktop }}px;
    }

    #shopify-section-{{ section.id }} .team-selector__track {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .team-selector__name {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .team-selector__arrow {
      position: absolute;
      top: calc(var(--ts-circle) / 2);
      z-index: 1;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgb(var(--background));
      color: rgb(var(--text-color));
      box-shadow: 0 1px 6px rgba(0, 0, 0, .15);
      transform: translateY(-50%);
      transition: opacity .2s ease;
    }

    #shopify-section-{{ section.id }} .team-selector__arrow[disabled] {
      opacity: 0;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .team-selector__arrow--prev {
      inset-inline-start: -8px;
    }

    #shopify-section-{{ section.id }} .team-selector__arrow--next {
      inset-inline-end: -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .team-selector__track {
      scroll-behavior: auto;
    }
  }
</style>

<div class="team-selector">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <h2 class="team-selector__title h5 {% if section.settings.title_alignment == 'center' %}text-center{% endif %}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <team-selector-strip style="display: block; position: relative;">
      {%- if ts_show_arrows -%}
        <button type="button" class="team-selector__arrow team-selector__arrow--prev" aria-label="{{ 'general.accessibility.previous' | t | escape }}" data-team-prev disabled>
          {%- render 'icon' with 'chevron-left', width: 16, height: 16 -%}
        </button>
      {%- endif -%}

      <ul class="team-selector__track scroll-area bleed" role="list" aria-label="{{ section.settings.title | default: 'Shop by team' | escape }}" data-team-track>
        {%- if ts_collections.size > 0 -%}
          {%- for collection in ts_collections -%}
            {%- liquid
              assign ts_name = collection.title
              if ts_strip != blank
                assign ts_name = ts_name | remove: ts_strip | strip
              endif

              assign ts_initials = ''
              assign ts_words = ts_name | split: ' '
              for ts_word in ts_words limit: 3
                assign ts_initial = ts_word | slice: 0
                assign ts_initials = ts_initials | append: ts_initial
              endfor
            -%}

            <li class="team-selector__item">
              <a href="{{ collection.url }}" class="team-selector__link">
                <span class="team-selector__logo">
                  {%- if collection.image != blank -%}
                    {%- assign ts_loading = 'lazy' -%}
                    {%- if section.index <= 3 and forloop.index <= 8 -%}{%- assign ts_loading = nil -%}{%- endif -%}
                    {{- collection.image | image_url: width: 240 | image_tag: loading: ts_loading, alt: '', sizes: '96px', widths: '120,240' -}}
                  {%- else -%}
                    <span class="team-selector__initials" aria-hidden="true">{{ ts_initials | upcase }}</span>
                  {%- endif -%}
                </span>
                <span class="team-selector__name">{{ ts_name | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <li class="team-selector__item">
              <span class="team-selector__link">
                <span class="team-selector__logo"><span class="team-selector__initials" aria-hidden="true">NBA</span></span>
                <span class="team-selector__name">Team {{ i }}</span>
              </span>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if ts_show_arrows -%}
        <button type="button" class="team-selector__arrow team-selector__arrow--next" aria-label="{{ 'general.accessibility.next' | t | escape }}" data-team-next>
          {%- render 'icon' with 'chevron-right', width: 16, height: 16 -%}
        </button>
      {%- endif -%}
    </team-selector-strip>
  </div>
</div>

<script>
  if (!window.customElements.get('team-selector-strip')) {
    window.customElements.define('team-selector-strip', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-team-track]');
        this.prev = this.querySelector('[data-team-prev]');
        this.next = this.querySelector('[data-team-next]');

        if (!this.track || (!this.prev && !this.next)) return;

        this.update = this.update.bind(this);
        this.prev?.addEventListener('click', () => this.scrollByPage(-1));
        this.next?.addEventListener('click', () => this.scrollByPage(1));
        this.track.addEventListener('scroll', this.update, { passive: true });
        window.addEventListener('resize', this.update);
        this.update();
      }

      disconnectedCallback() {
        this.track?.removeEventListener('scroll', this.update);
        window.removeEventListener('resize', this.update);
      }

      scrollByPage(direction) {
        const rtl = getComputedStyle(this.track).direction === 'rtl' ? -1 : 1;
        this.track.scrollBy({ left: direction * rtl * this.track.clientWidth * 0.8 });
      }

      update() {
        const max = this.track.scrollWidth - this.track.clientWidth;
        const position = Math.abs(this.track.scrollLeft);

        if (this.prev) this.prev.disabled = position <= 2;
        if (this.next) this.next.disabled = position >= max - 2;
      }
    });
  }
</script>

{% schema %}
{
  "name": "Team selector",
  "class": "shopify-section--team-selector",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Round team logos with the name underneath, swiped left and right. Each logo opens its collection. The logo is the collection image; without an image the team initials are shown."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Optional. Leave empty for the logo row only."
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "start"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Teams",
      "limit": 50,
      "info": "Pick the team collections in the order you want them shown."
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Text removed from names",
      "default": "Jerseys",
      "info": "\"Atlanta Hawks Jerseys\" is shown as \"Atlanta Hawks\". Leave empty to show the full collection title."
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle size on mobile",
      "min": 48,
      "max": 88,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "circle_size_desktop",
      "label": "Circle size on desktop",
      "min": 56,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "logo_scale",
      "label": "Logo size inside the circle",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "circle_background",
      "label": "Circle background",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "circle_border",
      "label": "Circle border"
    }
  ],
  "presets": [
    {
      "name": "Team selector"
    }
  ]
}
{% endschema %}
