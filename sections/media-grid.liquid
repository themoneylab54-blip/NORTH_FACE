{%- render 'section-spacing-collapsing' -%}

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
CSS
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign columns_tablet = columns_desktop | at_most: 4
  assign grid_gap = section.settings.grid_gap | default: 24, allow_false: false
  assign has_custom_gap = false

  if grid_gap != 24
    assign has_custom_gap = true
  endif

  assign sizes_px = 1560 | divided_by: columns_desktop
  assign sizes_vw = 100.0 | divided_by: columns_desktop

  comment
    "Single row" mobile layout: the tiles sit on one line that visitors swipe from left to right (below 700px only)
  endcomment
  assign mobile_row = false
  if section.settings.mobile_layout == 'row'
    assign mobile_row = true
  endif

  assign mobile_item_width = section.settings.mobile_item_width | default: 150
-%}

<style>
  #shopify-section-{{ section.id }} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
    --media-grid-columns: {{ columns_mobile }};
    {%- if has_custom_gap %}
    --media-grid-gap: {{ grid_gap }}px;
    {%- endif %}
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      --media-grid-columns: {{ columns_tablet }};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --media-grid-columns: {{ columns_desktop }};
    }
  }

  {%- comment -%}Columns / gap override (base grid in theme.css is 2 columns, then 4 columns from 700px){%- endcomment -%}
  {%- if columns_mobile != 2 or has_custom_gap %}
  #shopify-section-{{ section.id }} .media-grid {
    grid-template-columns: repeat(var(--media-grid-columns), minmax(0, 1fr));
    {%- if has_custom_gap %}
    gap: var(--media-grid-gap);
    {%- endif %}
  }
  {%- endif %}

  {%- if columns_desktop != 4 %}
  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .media-grid {
      grid-template-columns: repeat(var(--media-grid-columns), minmax(0, 1fr));
    }
    {%- comment -%}Clamp block spans to the available columns: CSS Grid adds implicit tracks for an oversize span rather than clamping it{%- endcomment -%}
    #shopify-section-{{ section.id }} .media-grid__item {
      grid-area: span var(--media-grid-row-span) / span min(var(--media-grid-columns), var(--media-grid-column-span));
    }
  }
  {%- endif %}

  {%- if section.settings.frame %}
  #shopify-section-{{ section.id }} .media-grid {
    width: 100%;
    max-width: {{ section.settings.frame_max_width | default: 1400 }}px;
    /* .section-stack is display:grid, so this element is a grid item: auto inline
       margins would suppress the default stretch and collapse the frame. */
    justify-self: center;
    margin-inline: auto;
    border-radius: 16px;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.08);
    overflow: hidden;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .media-grid__item {
    filter: none;
  }

  #shopify-section-{{ section.id }} .media-grid__item .content-over-media {
    border-radius: 0;
  }
  {%- endif %}

  {%- if mobile_row %}
  @media screen and (max-width: 699px) {
    /* One swipeable line, edge to edge: it starts aligned with the page content and slides under the screen edges */
    #shopify-section-{{ section.id }} .media-grid {
      grid: var(--media-grid-row-height) / auto-flow {{ mobile_item_width }}px;
      width: auto;
      max-width: none;
      justify-self: stretch;
      margin-inline: calc(-1 * var(--container-outer-width));
      padding-inline: var(--container-outer-width);
      scroll-padding-inline: var(--container-outer-width);
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      overflow: auto hidden;
      scrollbar-width: none;
      border-radius: 0;
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .media-grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .media-grid__item {
      grid-area: auto;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .media-grid__item .content-over-media {
      border-radius: var(--rounded-sm);
    }
  }
  {%- endif %}

  {%- for block in section.blocks -%}
    #media-grid-{{ block.id }} {
      --content-over-media-overlay: {{ block.settings.overlay_color.rgb }} /{{ block.settings.overlay_opacity | divided_by: 100.0 }};

      {%- if block.settings.heading_tag == 'h5' or block.settings.heading_tag == 'h6' -%}
        --content-over-media-gap: 1rem;
      {%- endif -%}
    }

    {%- if block.settings.heading_tag == 'h5' or block.settings.heading_tag == 'h6' -%}
      @media screen and (min-width: 740px) {
        #media-grid-{{ block.id }} {
          --content-over-media-gap: 1.5rem;
        }
      }
    {%- endif -%}
  {%- endfor -%}
</style>

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
LIQUID
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- comment -%}
  Tiles are built first: when none has content (see below) the whole section, heading included, is left out on the
  store, so an unfilled community grid never shows a lone title.
{%- endcomment -%}
{%- capture media_grid_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      comment
        An image tile with nothing in it (no image, text, button or color) would show as an empty box: it only appears
        in the theme editor, so it can still be selected and filled.
      endcomment
      if block.type == 'image' and request.design_mode == false
        if block.settings.image == blank and block.settings.title == blank and block.settings.link_text == blank and block.settings.background == blank and block.settings.background_gradient == blank
          continue
        endif
      endif
    -%}

    <a {% if block.settings.link_url != blank %}href="{{ block.settings.link_url }}"{% endif %} class="media-grid__item shadow group" reveal-js style="--media-grid-column-span: {{ block.settings.desktop_column_span }}; --media-grid-row-span: {{ block.settings.desktop_row_span }}" {{ block.shopify_attributes }}>
      <div id="media-grid-{{ block.id }}" {% render 'surface', class: 'content-over-media rounded', background: block.settings.background, background_gradient: block.settings.background_gradient, text_color: block.settings.text_color %}>
        {%- liquid
          assign loading_strategy = nil

          if section.index > 3 or forloop.index > 3
            assign loading_strategy = 'lazy'
          endif
        -%}
        
        {%- case block.type -%}
          {%- when 'image' -%}
            {%- if block.settings.image -%}
              {%- capture sizes -%}(max-width: 699px) {% if mobile_row %}{{ mobile_item_width }}px{% else %}100vw{% endif %}, min({{ sizes_px | times: block.settings.desktop_column_span }}px, {{ sizes_vw | times: block.settings.desktop_column_span | round: 2 }}vw){%- endcapture -%}
              {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000,2200,2400', class: 'content-over-media__media zoom-image' -}}
            {%- endif -%}

          {%- when 'video' -%}
            {%- if block.settings.video -%}
              <video-media autoplay style="--aspect-ratio: auto">
                {%- if block.settings.show_video_controls -%}
                  {%- assign loop_video = false -%}
                {%- else -%}
                  {%- assign loop_video = true -%}
                {%- endif -%}

                {{- block.settings.video | video_tag: playsinline: true, muted: true, loop: loop_video, controls: block.settings.show_video_controls, preload: 'metadata', class: 'object-fill' -}}
              </video-media>
            {%- else -%}
              <video-media host="{{ block.settings.external_video_url.type }}" autoplay style="--aspect-ratio: auto">
                <template>
                  {%- if block.settings.external_video_url.type == 'youtube' -%}
                    <iframe src="https://www.youtube.com/embed/{{ block.settings.external_video_url.id }}?playsinline=1&autoplay=1&controls=0&mute=1&loop=1&playlist={{ block.settings.external_video_url.id }}&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}" allow="autoplay; encrypted-media" allowfullscreen="allowfullscreen"></iframe>
                  {%- elsif block.settings.external_video_url.type == 'vimeo' -%}
                    <iframe src="https://player.vimeo.com/video/{{ block.settings.external_video_url.id }}?autoplay=1&autopause=1&background=1&loop=1&muted=1&transparent=0&responsive=1&portrait=0&title=0&byline=0&color={{ settings.text_color | remove_first: '#' }}" allow="autoplay; encrypted-media;" allowfullscreen="allowfullscreen"></iframe>
                  {%- endif -%}
                </template>
              </video-media>
            {%- endif -%}
        {%- endcase -%}

        {%- if block.settings.title != blank or block.settings.link_text != blank -%}
          <div class="{{ block.settings.mobile_text_position }} {{ block.settings.desktop_text_position }}">
            <div class="prose">
              {%- if block.settings.title != blank -%}
                <p class="{{ block.settings.heading_tag }}">
                  {% render 'styled-text', content: block.settings.title, gradient: block.settings.text_gradient %}
                </p>
              {%- endif -%}

              {%- if block.settings.link_text != blank -%}
                {%- render 'button', size: 'lg', content: block.settings.link_text, background: block.settings.button_background, text_color: block.settings.button_text_color -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- if media_grid_items != blank or request.design_mode -%}
<div {% render 'section-properties', narrow: section.settings.reduce_width %}>
  <div class="section-stack">
    {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content, text_alignment: section.settings.text_alignment -%}



  {%- if media_grid_items != blank -%}
    <media-grid class="media-grid">
      {{- media_grid_items -}}
    </media-grid>
  {%- endif -%}
  </div>
</div>
{%- endif -%}

