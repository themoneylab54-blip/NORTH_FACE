{%- liquid
  assign mode = section.settings.countdown_mode
  assign shop_offset_raw = 'now' | date: '%z'
  comment
    Strict ISO 8601 needs "+01:00" rather than "+0100" (Safari rejects the latter).
  endcomment
  assign shop_offset_hours = shop_offset_raw | slice: 0, 3
  assign shop_offset_minutes = shop_offset_raw | slice: 3, 2
  assign shop_offset = shop_offset_hours | append: ':' | append: shop_offset_minutes
  assign end_date = section.settings.end_date | default: '2026-12-31'
  assign end_time = section.settings.end_time | default: '23:59'
  assign target_iso = end_date | append: 'T' | append: end_time | append: ':00' | append: shop_offset

  assign start_iso = ''
  assign start_date = section.settings.start_date | strip
  if mode == 'fixed' and start_date != blank
    assign start_time = section.settings.start_time | default: '00:00' | strip
    assign start_iso = start_date | append: 'T' | append: start_time | append: ':00' | append: shop_offset
  endif

  comment
    First paint guess only (pages are cached): the script re-checks the phase against the visitor's clock.
  endcomment
  assign heading_text = section.settings.title
  if start_iso != blank and section.settings.teaser_title != blank
    assign now_seconds = 'now' | date: '%s' | plus: 0
    assign start_seconds = start_iso | date: '%s' | plus: 0
    if now_seconds < start_seconds
      assign heading_text = section.settings.teaser_title
    endif
  endif
-%}

{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --countdown-accent: {{ section.settings.digit_background | default: '#111111' }};
    --countdown-bar-digit-bg: {% if section.settings.digit_background != blank %}{{ section.settings.digit_background }}{% else %}rgba(255, 255, 255, 0.08){% endif %};
    --countdown-digit-color: {{ section.settings.digit_text_color | default: '#ffffff' }};
    --countdown-radius: {{ section.settings.digit_radius }}px;
    --section-spacing-block-start: {{ section.settings.spacing_block_start }}px;
    --section-spacing-block-end: {{ section.settings.spacing_block_end }}px;
  }

  .countdown__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-4);
    text-align: center;
  }

  @media screen and (min-width: 1000px) {
    .countdown__wrapper--inline {
      flex-direction: row;
      justify-content: center;
      gap: var(--spacing-8);
      text-align: start;
    }
  }

  /* Compact bar: one centred 53px row (bold 13px uppercase text + 32px digit boxes separated by ":") */
  .countdown__wrapper--bar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 53px;
    gap: var(--spacing-2) var(--spacing-3);
  }

  .countdown__wrapper--bar .countdown__content {
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-2);
  }

  .countdown__wrapper--bar .countdown__side {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .countdown__wrapper--bar .countdown__heading {
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .countdown__wrapper--bar .countdown__subheading {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 1;
  }

  .countdown__wrapper--bar .countdown__clock {
    align-items: center;
    gap: var(--spacing-1);
  }

  .countdown__wrapper--bar .countdown__unit {
    justify-content: center;
    min-width: 40px;
    height: 32px;
    padding: 0 var(--spacing-1);
    gap: 0;
    background: var(--countdown-bar-digit-bg);
    color: var(--countdown-digit-color);
    border-radius: 4px;
  }

  .countdown__wrapper--bar .countdown__value {
    width: auto;
    padding: 0;
    background: transparent;
    border-radius: 0;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0;
  }

  .countdown__wrapper--bar .countdown__label {
    font-size: 9px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    opacity: 0.7;
  }

  .countdown__wrapper--bar .countdown__separator {
    display: inline;
    align-self: center;
    padding-top: 0;
    font-size: 14px;
    opacity: 0.6;
  }

  .countdown__wrapper--bar .countdown__cta {
    margin-top: 0;
  }

  .countdown__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    align-items: center;
  }

  @media screen and (min-width: 1000px) {
    .countdown__wrapper--inline .countdown__content {
      align-items: flex-start;
    }
  }

  .countdown__heading {
    margin: 0;
    text-wrap: balance;
  }

  .countdown__subheading {
    margin: 0;
    opacity: 0.85;
  }

  .countdown__clock {
    display: grid;
    grid-auto-flow: column;
    gap: var(--spacing-2);
    align-items: start;
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
    min-width: 62px;
  }

  .countdown__value {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--spacing-3) var(--spacing-2);
    background: var(--countdown-accent);
    color: var(--countdown-digit-color);
    border-radius: var(--countdown-radius);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.35rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .countdown__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .countdown__separator {
    align-self: start;
    padding-top: var(--spacing-3);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.35;
  }

  .countdown__cta {
    margin-top: var(--spacing-2);
  }

  countdown-timer:not(.countdown--ready) .countdown__clock {
    visibility: hidden;
  }

  {%- if section.settings.sticky -%}
    /* Stays on screen while scrolling (like the theme's sticky announcement bar); the sticky announcement bar and
       header below are pushed down by its height, measured by <height-observer variable="offer-bar"> */
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 20;
    }

    :root #shopify-section-{{ section.id }} ~ .shopify-section--announcement-bar:not(.shopify-section--header ~ *) {
      top: var(--offer-bar-height, 0px);
    }

    :root #shopify-section-{{ section.id }} ~ .shopify-section--header {
      top: calc(var(--offer-bar-height, 0px) + var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  @media (prefers-reduced-motion: no-preference) {
    .countdown--pulse .countdown__value,
    .countdown__wrapper--bar .countdown--pulse .countdown__unit {
      animation: countdownPulse 1s ease-in-out infinite;
    }

    @keyframes countdownPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
  }
</style>

{%- if section.settings.sticky -%}<height-observer variable="offer-bar">{%- endif -%}
<div {% render 'section-properties' %}>
  <countdown-timer
    class="countdown"
    data-mode="{{ mode }}"
    data-target="{{ target_iso }}"
    data-start="{{ start_iso }}"
    data-title="{{ section.settings.title | escape }}"
    data-teaser-title="{{ section.settings.teaser_title | escape }}"
    data-daily-hour="{{ section.settings.daily_reset_hour }}"
    data-evergreen-minutes="{{ section.settings.evergreen_minutes }}"
    data-evergreen-scope="{{ section.settings.evergreen_scope | default: 'visitor' }}"
    data-timer-id="{{ section.id }}"
    data-on-expiry="{{ section.settings.on_expiry }}"
    data-hide-days="{% if section.settings.show_days %}false{% else %}true{% endif %}"
  >
    <div class="countdown__wrapper countdown__wrapper--{{ section.settings.layout }}">
      <div class="countdown__content">
        {%- if section.settings.subheading != blank -%}
          <p class="countdown__subheading bold text-sm uppercase">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if heading_text != blank -%}
          {%- if section.settings.layout == 'bar' -%}
            <p class="countdown__heading">{{ heading_text | escape }}</p>
          {%- else -%}
            <{{ section.settings.heading_tag | default: 'h2' }} class="countdown__heading h3">
              {{- heading_text | escape -}}
            </{{ section.settings.heading_tag | default: 'h2' }}>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="countdown__subheading text-sm">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>

      <div class="countdown__side">
        <div class="countdown__clock{% if section.settings.pulse %} countdown--pulse{% endif %}" role="timer" aria-live="off">
          {%- if section.settings.show_days -%}
            <div class="countdown__unit" data-unit="days">
              <span class="countdown__value" data-countdown-days>00</span>
              <span class="countdown__label">{{ section.settings.label_days | escape }}</span>
            </div>
            <span class="countdown__separator" aria-hidden="true">:</span>
          {%- endif -%}

          <div class="countdown__unit">
            <span class="countdown__value" data-countdown-hours>00</span>
            <span class="countdown__label">{{ section.settings.label_hours | escape }}</span>
          </div>
          <span class="countdown__separator" aria-hidden="true">:</span>

          <div class="countdown__unit">
            <span class="countdown__value" data-countdown-minutes>00</span>
            <span class="countdown__label">{{ section.settings.label_minutes | escape }}</span>
          </div>
          <span class="countdown__separator" aria-hidden="true">:</span>

          <div class="countdown__unit">
            <span class="countdown__value" data-countdown-seconds>00</span>
            <span class="countdown__label">{{ section.settings.label_seconds | escape }}</span>
          </div>
        </div>

        {%- if section.settings.button_text != blank -%}
          <div class="countdown__cta">
            {%- liquid
              assign cta_size = 'lg'
              if section.settings.layout == 'bar'
                assign cta_size = 'sm'
              endif
            -%}
            {%- render 'button',
              content: section.settings.button_text,
              href: section.settings.button_url,
              size: cta_size,
              background: section.settings.button_background,
              text_color: section.settings.button_text_color
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.expired_text != blank -%}
      <p class="countdown__expired text-center bold" hidden data-countdown-expired>
        {{- section.settings.expired_text | escape -}}
      </p>
    {%- endif -%}
  </countdown-timer>
</div>
{%- if section.settings.sticky -%}</height-observer>{%- endif -%}

<script>
  if (!window.customElements.get('countdown-timer')) {
    window.customElements.define('countdown-timer', class extends HTMLElement {
      connectedCallback() {
        this.days = this.querySelector('[data-countdown-days]');
        this.hours = this.querySelector('[data-countdown-hours]');
        this.minutes = this.querySelector('[data-countdown-minutes]');
        this.seconds = this.querySelector('[data-countdown-seconds]');
        this.clock = this.querySelector('.countdown__clock');
        this.expired = this.querySelector('[data-countdown-expired]');
        this.hideDays = this.dataset.hideDays === 'true';

        this.deadline = this.resolveDeadline();

        if (!this.deadline) {
          this.handleExpiry();
          return;
        }

        this.tick();
        this.classList.add('countdown--ready');
        this.interval = setInterval(() => this.tick(), 1000);
      }

      disconnectedCallback() {
        clearInterval(this.interval);
      }

      resolveDeadline() {
        const now = Date.now();
        this.phase = 'live';

        // Optional start date: before it, count down to the start with the teaser heading (or stay hidden).
        if (this.dataset.mode === 'fixed' && this.dataset.start) {
          const start = Date.parse(this.dataset.start);

          if (!isNaN(start) && now < start) {
            this.phase = 'teaser';
            this.setHeading(this.dataset.teaserTitle);
            this.toggleSection(Boolean(this.dataset.teaserTitle));
            return start;
          }

          this.setHeading(this.dataset.title);
          this.toggleSection(true);
        }

        if (this.dataset.mode === 'daily') {
          const resetHour = parseInt(this.dataset.dailyHour, 10) || 0;
          const next = new Date();
          next.setHours(resetHour, 0, 0, 0);
          if (next.getTime() <= now) next.setDate(next.getDate() + 1);
          return next.getTime();
        }

        if (this.dataset.mode === 'evergreen') {
          const minutes = parseInt(this.dataset.evergreenMinutes, 10) || 30;
          const storageKey = 'countdown-timer-' + this.dataset.timerId;
          // "session" keeps the deadline only for this tab's visit, so a new visit starts a
          // fresh countdown; "visitor" keeps it across visits on this device.
          const perSession = this.dataset.evergreenScope === 'session';
          let store = null;

          try {
            store = perSession ? sessionStorage : localStorage;
          } catch (error) {
            store = null;
          }

          let stored = null;

          try {
            const raw = store && store.getItem(storageKey);
            const parsedStore = raw === null || raw === undefined ? NaN : parseInt(raw, 10);
            stored = Number.isFinite(parsedStore) ? parsedStore : null;
          } catch (error) {
            stored = null;
          }

          if (!stored || stored <= now) {
            stored = now + minutes * 60000;
            try {
              if (store) store.setItem(storageKey, String(stored));
            } catch (error) {
              // Storage unavailable (private mode): the timer still runs for this page view.
            }
          }

          return stored;
        }

        const parsed = Date.parse(this.dataset.target);
        return isNaN(parsed) ? null : parsed;
      }

      tick() {
        const remaining = this.deadline - Date.now();

        if (remaining <= 0) {
          // End of the teaser: switch to the live offer and keep counting.
          if (this.phase === 'teaser') {
            const next = this.resolveDeadline();

            if (next && next > Date.now()) {
              this.deadline = next;
              this.tick();
              return;
            }
          }

          clearInterval(this.interval);
          this.handleExpiry();
          return;
        }

        const totalSeconds = Math.floor(remaining / 1000);
        let hours = Math.floor(totalSeconds / 3600);
        const days = Math.floor(hours / 24);

        if (!this.hideDays) {
          hours = hours % 24;
          this.days.textContent = this.pad(days);
        }

        this.hours.textContent = this.pad(hours);
        this.minutes.textContent = this.pad(Math.floor((totalSeconds % 3600) / 60));
        this.seconds.textContent = this.pad(totalSeconds % 60);
      }

      setHeading(text) {
        const heading = this.querySelector('.countdown__heading');
        if (heading && text) heading.textContent = text;
      }

      // Hides the whole section (not only the timer) so no empty coloured strip is left behind.
      toggleSection(visible) {
        const section = this.closest('.shopify-section') || this;
        section.hidden = !visible;
      }

      handleExpiry() {
        if (this.dataset.onExpiry === 'hide') {
          this.toggleSection(false);
          return;
        }

        if (this.dataset.onExpiry === 'restart') {
          const next = this.resolveDeadline();

          // A fixed end date cannot restart: re-resolving returns the same past
          // moment, so fall through to the expired state instead of looping.
          if (next && next > Date.now()) {
            this.deadline = next;
            clearInterval(this.interval);
            this.tick();
            this.interval = setInterval(() => this.tick(), 1000);
            return;
          }
        }

        [this.days, this.hours, this.minutes, this.seconds].forEach((element) => {
          if (element) element.textContent = '00';
        });

        this.classList.add('countdown--ready');

        if (this.expired) {
          this.expired.hidden = false;
          if (this.clock) this.clock.hidden = true;
        }
      }

      pad(value) {
        return String(Math.max(0, value)).padStart(2, '0');
      }
    });
  }
</script>

{% schema %}
{
  "name": "Countdown timer",
  "class": "shopify-section--countdown-timer",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "inline",
          "label": "Side by side"
        },
        {
          "value": "bar",
          "label": "Compact bar"
        }
      ],
      "default": "inline"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stay visible when scrolling",
      "info": "For a bar at the very top of the page. The sticky header stays right under it.",
      "default": false
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Countdown type",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed end date"
        },
        {
          "value": "daily",
          "label": "Resets every day"
        },
        {
          "value": "evergreen",
          "label": "Per visitor"
        }
      ],
      "default": "fixed",
      "info": "\"Per visitor\" starts a fresh timer the first time each visitor sees this section."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "default": "2026-12-31",
      "info": "Format YYYY-MM-DD. Used with \"Fixed end date\"."
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time",
      "default": "23:59",
      "info": "Format HH:MM, in your store's timezone."
    },
    {
      "type": "text",
      "id": "start_date",
      "label": "Start date (optional)",
      "info": "Format YYYY-MM-DD. With \"Fixed end date\": before this date the bar counts down to the start with the teaser heading, then switches to the heading below by itself."
    },
    {
      "type": "text",
      "id": "start_time",
      "label": "Start time",
      "default": "00:00",
      "info": "Format HH:MM, in your store's timezone."
    },
    {
      "type": "text",
      "id": "teaser_title",
      "label": "Heading before the start",
      "info": "E.g. \"Black Friday starts in\". Leave empty to hide the bar until the start date."
    },
    {
      "type": "range",
      "id": "daily_reset_hour",
      "label": "Daily reset hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 0,
      "info": "Used with \"Resets every day\"."
    },
    {
      "type": "range",
      "id": "evergreen_minutes",
      "label": "Minutes per visitor",
      "min": 10,
      "max": 720,
      "step": 10,
      "default": 30,
      "unit": "min",
      "info": "Used with \"Per visitor\". 420 = 7 hours."
    },
    {
      "type": "select",
      "id": "evergreen_scope",
