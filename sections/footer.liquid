{%- assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first -%}
{%- assign logo_strip_block = section.blocks | where: 'type', 'logo_strip' | first -%}
{%- assign footer_style = section.settings.footer_style | default: 'editorial' -%}

{%- liquid
  comment
    Number of blocks that are laid out as regular columns in the editorial layout (everything except the
    logo strip, the first text block and the newsletter, which share the wide first column).
  endcomment
  assign editorial_column_count = section.blocks.size
  if logo_strip_block != blank
    assign editorial_column_count = editorial_column_count | minus: 1
  endif
  if newsletter_block != blank
    assign editorial_column_count = editorial_column_count | minus: 1
  endif
  for block in section.blocks
    unless block.type == 'logo_strip'
      if block.type == 'text'
        assign editorial_column_count = editorial_column_count | minus: 1
      endif
      break
    endunless
  endfor
  assign editorial_column_count = editorial_column_count | at_least: 1
-%}

{%- if section.blocks.size > 3 -%}
<style>
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if newsletter_block != blank -%}
        --footer-block-list-gap: var(--spacing-10);
      {%- endif -%}

      --footer-block-list-justify-content: space-between;
    }
  }
</style>
{%- endif -%}

{%- if logo_strip_block != blank -%}
<style>
  #shopify-section-{{ section.id }} .footer__logo-strip {
    margin-block-start: calc(-1 * var(--footer-padding-block));
    margin-block-end: var(--footer-part-gap);
    padding-block-start: var(--spacing-7);
    padding-block-end: var(--spacing-7);
    border-block-end: 1px solid rgb(var(--text-color) / .1);
  }

  #shopify-section-{{ section.id }} .footer__logo-strip-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 40px;
  }

  #shopify-section-{{ section.id }} .footer__logo-strip-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .footer__logo-strip-image {
    display: block;
    height: 28px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: .6;
    transition: opacity .2s ease-in-out;
  }

  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} a.footer__logo-strip-item:hover .footer__logo-strip-image {
      opacity: 1;
    }
  }
</style>
{%- endif -%}

{%- if footer_style == 'editorial' -%}
<style>
  #shopify-section-{{ section.id }} .footer {
    --background: 26 26 26;
    --text-color: 245 245 245;
    --footer-muted-text: 163 163 163;
    --footer-faint-text: 115 115 115;
    --footer-line-color: rgb(var(--text-color) / .1);
  }

  /* Column titles */
  #shopify-section-{{ section.id }} .footer__block > .bold {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--footer-muted-text));
  }

  /* Link columns */
  #shopify-section-{{ section.id }} .footer__block--menu ul {
    gap: var(--spacing-2-5);
  }

  #shopify-section-{{ section.id }} .footer__block--menu a {
    font-size: 15px;
    line-height: 1.5;
    color: rgb(var(--footer-muted-text));
    opacity: 1;
    transition: color .2s ease-in-out;
  }

  /* Body text */
  #shopify-section-{{ section.id }} .footer__block--text .prose,
  #shopify-section-{{ section.id }} .footer__block--newsletter .prose {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .footer__block--text .prose a:not(.button),
  #shopify-section-{{ section.id }} .footer__block--newsletter .prose a:not(.button) {
    color: rgb(var(--footer-muted-text));
    background: none;
    transition: color .2s ease-in-out;
  }

  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} .footer__block--menu a:hover,
    #shopify-section-{{ section.id }} .footer__block--text .prose a:not(.button):hover,
    #shopify-section-{{ section.id }} .footer__block--newsletter .prose a:not(.button):hover {
      color: rgb(var(--text-color));
    }
  }

  /* Newsletter */
  #shopify-section-{{ section.id }} .footer__block--newsletter {
    gap: var(--spacing-6);
  }

  #shopify-section-{{ section.id }} .footer__block--newsletter :is(.h3, .h4, .h5, .h6) {
    font-family: var(--text-font-family);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--spacing-4) 0;
    max-width: 480px;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form > .banner {
    flex-basis: 100%;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form > .form-control {
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form .input {
    height: 52px;
    border: 1px solid rgb(255 255 255 / .15);
    border-radius: 0;
    border-start-start-radius: 12px;
    border-end-start-radius: 12px;
    background: rgb(255 255 255 / .06);
    color: rgb(var(--text-color));
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form .input:focus {
    outline: none;
    border-color: rgb(255 255 255 / .4);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form .floating-label {
    height: 52px;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form > .button {
    --button-background: 255 255 255;
    --button-text-color: 23 23 23;
    --button-outline-color: 255 255 255;
    flex: 0 0 auto;
    height: 52px;
    border-radius: 0;
    border-start-end-radius: 12px;
    border-end-end-radius: 12px;
    padding-block-start: 0;
    padding-block-end: 0;
    padding-inline-start: 22px;
    padding-inline-end: 22px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.12px;
    text-transform: uppercase;
    line-height: 52px;
  }

  /* Secondary area */
  #shopify-section-{{ section.id }} .footer__aside {
    gap: var(--spacing-6);
    padding-block-start: var(--spacing-8);
    border-block-start: 1px solid var(--footer-line-color);
  }

  #shopify-section-{{ section.id }} .footer__aside-top {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .social-media a {
    color: rgb(var(--footer-muted-text));
    transition: color .2s ease-in-out;
  }

  #shopify-section-{{ section.id }} .footer__aside-bottom {
    flex-direction: column;
    justify-content: center;
    justify-items: center;
    gap: var(--spacing-4);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .footer__payment-icons {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .footer__copyright {
    order: 0;
    align-items: center;
    justify-items: center;
    gap: var(--spacing-1);
  }

  #shopify-section-{{ section.id }} .footer__copyright p,
  #shopify-section-{{ section.id }} .footer__contact-email,
  #shopify-section-{{ section.id }} .footer__policy-links a {
    font-size: 13px;
    line-height: 1.6;
    color: rgb(var(--footer-faint-text));
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .footer__policy-links {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .footer__contact-email {
    display: inline-block;
    transition: color .2s ease-in-out;
  }

  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} .social-media a:hover,
    #shopify-section-{{ section.id }} .footer__contact-email:hover,
    #shopify-section-{{ section.id }} .footer__policy-links a:hover {
      color: rgb(var(--text-color));
    }
  }

  /* Layout: a wide first column (text + newsletter) followed by the link columns */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .footer__block-list {
      display: grid;
      grid-auto-flow: row dense;
      grid-template-columns: minmax(0, 1.8fr) repeat({{ editorial_column_count }}, minmax(0, 1fr));
      gap: var(--spacing-10) var(--spacing-12);
    }

    #shopify-section-{{ section.id }} .footer__block--text,
    #shopify-section-{{ section.id }} .footer__block--newsletter,
    #shopify-section-{{ section.id }} .footer__block--menu {
      grid-column: auto;
      max-width: none;
      flex-basis: auto;
    }

    #shopify-section-{{ section.id }} .footer__block--text:first-child,
    #shopify-section-{{ section.id }} .footer__block--newsletter {
      grid-column: 1;
      max-width: 420px;
    }

    #shopify-section-{{ section.id }} .footer__block--menu:last-child {
      margin-inline-end: 0;
    }
  }
</style>
{%- endif -%}

<div class="footer {% if footer_style == 'editorial' %}footer--editorial{% endif %}">
  {%- comment -%}
  ------------------------------------------------------------------------------------------------------------------
  LOGO STRIP (full-width band above the columns)
  ------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if logo_strip_block != blank -%}
    {%- capture logo_strip_items -%}
      {%- for i in (1..8) -%}
        {%- assign logo_key = 'logo_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}
        {%- assign strip_logo = logo_strip_block.settings[logo_key] -%}
        {%- assign strip_link = logo_strip_block.settings[link_key] -%}

        {%- if strip_logo != blank -%}
          {%- capture strip_logo_tag -%}
            {{- strip_logo | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 320, 480', sizes: '160px', class: 'footer__logo-strip-image' -}}
          {%- endcapture -%}

          <li>
            {%- if strip_link != blank -%}
              <a href="{{ strip_link }}" class="footer__logo-strip-item">{{- strip_logo_tag -}}</a>
            {%- else -%}
              <div class="footer__logo-strip-item">{{- strip_logo_tag -}}</div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if logo_strip_items != blank -%}
      <div class="footer__logo-strip" {{ logo_strip_block.shopify_attributes }}>
        <div class="container">
          <ul class="footer__logo-strip-list unstyled-list" role="list">
            {{- logo_strip_items -}}
          </ul>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="container">
    <div class="footer__wrapper">
      {%- comment -%}
      ------------------------------------------------------------------------------------------------------------------
      BLOCK AREA
      ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if section.blocks.size > 0 -%}
        <div class="footer__block-list empty:hidden">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'logo_strip' -%}
                {%- comment -%}Rendered above the columns{%- endcomment -%}

              {%- when 'text' -%}
                {%- if block.settings.title != blank or block.settings.content != blank or shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                  <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
                    {%- if block.settings.title != blank -%}
                      <p class="bold">{{ block.settings.title | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.content != blank -%}
                      <div class="prose text-subdued">
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}

                    {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                      <div class="follow-on-shop">
                        {{- shop | login_button: action: 'follow' -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'links' -%}
                {%- if block.settings.menu != blank -%}
                  <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_menu_title -%}
                      <p class="bold">{{ block.settings.menu_title | default: block.settings.menu.title }}</p>
                    {%- endif -%}

                    <ul class="v-stack gap-3" role="list">
                      {%- for link in block.settings.menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="inline-block link-faded break-all">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- when 'newsletter' -%}
                <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- capture sizes -%}{{ block.settings.image_width }}px{%- endcapture -%}
                    {%- capture widths -%}{{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 | at_most: block.settings.image.width }}{%- endcapture -%}
                    {%- capture style -%}max-width: {{ block.settings.image_width }}px{%- endcapture -%}
                    {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', style: style, sizes: sizes, widths: widths -}}
                  {%- endif -%}

                  <div class="v-stack gap-6">
                    {%- if block.settings.title != blank -%}
                      <p class="{{ block.settings.heading_size }}">{{- block.settings.title | escape -}}</p>
                    {%- endif -%}

                    {%- if block.settings.content != blank -%}
                      <div class="prose text-subdued">
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}

                    {%- form 'customer', id: 'footer-newsletter', class: 'footer__newsletter-form form' -%}
                      {%- if form.posted_successfully? -%}
                        {%- capture success_message -%}{{ 'general.newsletter.subscribed_successfully' | t }}{%- endcapture -%}
                        {%- render 'banner', content: success_message, status: 'success' -%}
                      {%- else -%}
                        {%- if form.errors -%}
                          {%- capture error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
                          {%- render 'banner', content: error_message, status: 'error' -%}
                        {%- endif -%}

                        <input type="hidden" name="contact[tags]" value="newsletter">

                        {%- capture label -%}{{ 'general.newsletter.email' | t }}{%- endcapture -%}

                        {%- if footer_style == 'editorial' -%}
                          {%- render 'input', name: 'contact[email]', label: label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send' -%}

                          {%- capture submit_label -%}{{ 'general.newsletter.subscribe' | t }}{%- endcapture -%}
                          {%- render 'button', content: submit_label, type: 'submit' -%}
                        {%- else -%}
                          {%- render 'input', name: 'contact[email]', label: label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send', self_submit: true -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endform -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
      ------------------------------------------------------------------------------------------------------------------
      SECONDARY AREA
      ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="footer__aside empty:hidden">
        {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        SOCIAL MEDIA + LOCALIZATION
        ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- if section.settings.show_social_media -%}
          {%- capture social_media -%}{%- render 'social-media' -%}{%- endcapture -%}
        {%- endif -%}

        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- assign country_selector = true -%}
        {%- endif -%}

        {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
          {%- assign locale_selector = true -%}
        {%- endif -%}

        {%- if social_media != blank or country_selector or locale_selector -%}
          <div class="footer__aside-top">
            {{- social_media -}}

            {%- if country_selector or locale_selector -%}
              <div class="h-stack gap-6">
                {%- if social_media == blank -%}
                  {%- assign popover_horizontal_position = 'start' -%}
                {%- else -%}
                  {%- assign popover_horizontal_position = 'end' -%}
                {%- endif -%}

                {%- if country_selector -%}
                  {%- render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, popover_horizontal_position: popover_horizontal_position -%}
                {%- endif -%}

                {%- if locale_selector -%}
                  {%- render 'localization-selector', type: 'locale', popover_horizontal_position: popover_horizontal_position -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        COPYRIGHT + PAYMENT METHODS
        ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        <div class="footer__aside-bottom">
          {%- if section.settings.show_payment_icons -%}
            {%- capture footer_payment_icons -%}
              {%- render 'payment-icon-list', source: section.settings.payment_icons_source, list: section.settings.payment_icons_list, wrapper: 'li', wrapper_class: 'contents' -%}
            {%- endcapture -%}

            {%- if footer_payment_icons != blank -%}
              <ul class="footer__payment-icons h-stack wrap gap-2">
                {{- footer_payment_icons -}}
              </ul>
            {%- endif -%}
          {%- endif -%}

          <div class="footer__copyright v-stack gap-1">
            {%- if section.settings.contact_email != blank -%}
              <a href="mailto:{{ section.settings.contact_email | escape }}" class="footer__contact-email text-sm link-faded">{{ section.settings.contact_email | escape }}</a>
            {%- endif -%}

            <p class="text-sm text-subdued">© {{ 'now' | date: '%Y' }}, {{ shop.name }}.</p>

            {%- if section.settings.show_policy_links and shop.policies.size > 0 -%}
              <ul class="footer__policy-links unstyled-list">
                {%- for policy in shop.policies -%}
                  <li class="contents"><a href="{{ policy.url }}" class="text-sm link-faded">{{ policy.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "tag": "footer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "footer_style",
      "label": "Style",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "editorial",
          "label": "Dark editorial"
        }
      ],
      "default": "editorial",
      "info": "Dark editorial uses a wide first column, uppercase column titles, an inline newsletter form and a centred bottom bar. Theme default restores the original footer layout."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact e-mail",
      "info": "Shown in the bottom bar above the copyright line. Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show social media",
      "info": "To configure social media, go to your social media settings.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "select",
      "id": "payment_icons_source",
      "label": "Payment icons shown",
      "options": [
        {
          "value": "custom",
          "label": "My list below"
        },
        {
          "value": "store",
          "label": "Methods enabled in Shopify payments"
        }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "payment_icons_list",
      "label": "Payment icon list",
      "default": "visa, master, american_express, discover, paypal, apple_pay, google_pay, shopify_pay, venmo, klarna, afterpay",
      "info": "Comma-separated, in display order. Names: visa, master, american_express, discover, diners_club, jcb, paypal, apple_pay, google_pay, shopify_pay, venmo, klarna, afterpay, amazon, unionpay, maestro."
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "info": "To add store policies, go to your [policy settings](/admin/settings/legal)."
    },
    {
      "type": "header",
      "content": "Country/region selector",
      "info": "To add a country/region, go to your [markets settings.](/admin/settings/markets)"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_flag",
      "label": "Show country flag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_name",
      "label": "Show country name",
      "default": true
    },
    {
      "type": "header",
      "content": "Language selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo_strip",
      "name": "Logo strip",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "A full-width band of up to 8 partner or league logos shown above the footer columns. Logos are displayed in grey at 28px tall; transparent .png or .svg files work best."
        },
        {
          "type": "image_picker",
          "id": "logo_1",
          "label": "Logo 1"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Link 1"
        },
        {
          "type": "image_picker",
          "id": "logo_2",
          "label": "Logo 2"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Link 2"
        },
        {
          "type": "image_picker",
          "id": "logo_3",
          "label": "Logo 3"
        },
        {
          "type": "url",
          "id": "link_3",
          "label": "Link 3"
        },
        {
          "type": "image_picker",
          "id": "logo_4",
          "label": "Logo 4"
        },
        {
          "type": "url",
          "id": "link_4",
          "label": "Link 4"
        },
        {
          "type": "image_picker",
          "id": "logo_5",
          "label": "Logo 5"
        },
        {
          "type": "url",
          "id": "link_5",
          "label": "Link 5"
        },
        {
          "type": "image_picker",
          "id": "logo_6",
          "label": "Logo 6"
        },
        {
          "type": "url",
          "id": "link_6",
          "label": "Link 6"
        },
        {
          "type": "image_picker",
          "id": "logo_7",
          "label": "Logo 7"
        },
        {
