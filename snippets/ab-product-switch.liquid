{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
A/B PRODUCT PAGE (time based, single page)
----------------------------------------------------------------------------------------------------------------------

Rendered first thing in <head>. Versions A and B live in the same product page: each product block has an
"A/B test version" setting (both versions / version A only / version B only). During the daily time window set in
Theme settings > "A/B test pages produit", version A is shown; the rest of the time, version B. Everyone sees the same
version at the same time, and the page never redirects.

* The version is set on <html data-ab-version="A|B"> before the page paints, so blocks never flash.
* Time is read in the store's timezone (UTC offset rendered by Liquid) or in the IANA timezone set in the settings
  (e.g. the ad account's timezone), which also follows daylight saving time.
* ?ab_preview=a or ?ab_preview=b forces a version, to check both at any time.
* In the theme editor both versions are shown, each A/B block tagged "Version A" / "Version B", so all can be edited.
* When the page has A/B blocks, the version seen is saved on the cart as the attribute "A/B page produit" (visible on
  the order) and published as the "ab_product_page_view" customer event for custom pixels.
{%- endcomment -%}

{%- if settings.ab_enabled and request.design_mode -%}
  <style>
    [data-ab-only] { position: relative; outline: 1px dashed rgba(17, 17, 17, .35); outline-offset: 4px; }
    [data-ab-only]::before {
      content: "Version " attr(data-ab-only);
      position: absolute; inset-block-start: -10px; inset-inline-end: 0; z-index: 2;
      padding: 1px 6px; border-radius: 2px; background: #111111; color: #ffffff;
      font: 700 10px/1.4 var(--text-font-family); letter-spacing: .08em; text-transform: uppercase;
    }
  </style>
{%- elsif settings.ab_enabled -%}
  <style>
    html:not([data-ab-version="A"]) [data-ab-only="a"],
    html[data-ab-version="A"] [data-ab-only="b"] { display: none !important; }
  </style>

  {%- if request.page_type == 'product' -%}
    <script>
      (function () {
        var config = {
          start: {{ settings.ab_start | default: '23:30' | strip | json }},
          end: {{ settings.ab_end | default: '01:00' | strip | json }},
          timezone: {{ settings.ab_timezone | strip | json }},
          shopOffset: {{ 'now' | date: '%z' | json }},
          tagOrders: {{ settings.ab_tag_orders | json }}
        };

        function toMinutes(value, fallback) {
          var match = /^(\d{1,2}):(\d{2})$/.exec(value || '');
          return match ? Math.min(+match[1], 23) * 60 + Math.min(+match[2], 59) : fallback;
        }

        function minutesNow() {
          var now = new Date();

          if (config.timezone) {
            try {
              var hour = 0, minute = 0;
              new Intl.DateTimeFormat('en-US', { timeZone: config.timezone, hourCycle: 'h23', hour: 'numeric', minute: 'numeric' })
                .formatToParts(now)
                .forEach(function (part) {
                  if (part.type === 'hour') hour = parseInt(part.value, 10) % 24;
                  if (part.type === 'minute') minute = parseInt(part.value, 10);
                });
              return hour * 60 + minute;
            } catch (error) {
              // Unknown timezone name: fall back to the store timezone.
            }
          }

          var offset = /^([+-])(\d{2}):?(\d{2})$/.exec(config.shopOffset || '');
          var offsetMinutes = offset ? (offset[1] === '-' ? -1 : 1) * (parseInt(offset[2], 10) * 60 + parseInt(offset[3], 10)) : 0;
          var shifted = new Date(now.getTime() + offsetMinutes * 60000);
          return shifted.getUTCHours() * 60 + shifted.getUTCMinutes();
        }

        var start = toMinutes(config.start, 1410);
        var end = toMinutes(config.end, 60);
        var now = minutesNow();
        var inWindow = start === end ? false : (start < end ? now >= start && now < end : now >= start || now < end);

        var preview = (new URL(window.location.href).searchParams.get('ab_preview') || '').toLowerCase();
        var version = preview === 'a' ? 'A' : (preview === 'b' ? 'B' : (inWindow ? 'A' : 'B'));
        document.documentElement.setAttribute('data-ab-version', version);

        // Only pages that actually contain A/B blocks take part in the test.
        function inTest() {
          return document.querySelector('[data-ab-only]') !== null;
        }

        if (config.tagOrders) {
          document.addEventListener('DOMContentLoaded', function () {
            if (!inTest()) return;

            try {
              if (sessionStorage.getItem('ab-product-page') === version) return;
            } catch (error) {}

            var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            fetch(root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ attributes: { 'A/B page produit': version } })
            }).then(function (response) {
              if (!response.ok) return;
              try { sessionStorage.setItem('ab-product-page', version); } catch (error) {}
            }).catch(function () {});
          });
        }

        window.addEventListener('load', function () {
          if (!inTest()) return;
          try {
            if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
              window.Shopify.analytics.publish('ab_product_page_view', { version: version });
            }
          } catch (error) {}
        });
      })();
    </script>
  {%- endif -%}
{%- else -%}
  {%- comment -%}A/B test off: blocks for version A hide, everything else shows.{%- endcomment -%}
  <style>[data-ab-only="a"] { display: none !important; }</style>
{%- endif -%}

{%- comment -%}
  Old links to the former separate version A page (?view=version-a): drop the parameter and show the product.
{%- endcomment -%}
{%- if request.page_type == '404' -%}
  <script>
    (function () {
      var url = new URL(window.location.href);
      if (url.searchParams.get('view') === 'version-a' && url.pathname.indexOf('/products/') !== -1) {
        url.searchParams.delete('view');
        window.location.replace(url.toString());
      }
    })();
  </script>
{%- endif -%}
