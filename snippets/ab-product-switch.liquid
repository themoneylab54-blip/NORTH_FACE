{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
A/B PRODUCT PAGE SWITCH (time based)
----------------------------------------------------------------------------------------------------------------------

Rendered first thing in <head>. For products assigned to template B, shows template A (through Shopify's ?view=
parameter) during the daily time window set in Theme settings > "A/B test pages produit", and template B the rest of
the time. Everyone sees the same version at the same time.

* Time is read in the store's timezone (UTC offset rendered by Liquid) or in the IANA timezone set in the settings
  (e.g. the ad account's timezone), which also follows daylight saving time.
* It never switches in the theme editor, so both templates can be edited.
* ?ab_preview=a or ?ab_preview=b forces a version, to check both pages at any time.
* The version seen is saved on the cart as the attribute "A/B page produit" (visible on the order), exposed as
  html[data-ab-version] and published as the "ab_product_page_view" customer event for custom pixels.
{%- endcomment -%}

{%- comment -%}
  Safety net: if the redirect to template A lands on a 404 (template A missing or not yet synced on the store), go
  straight back to the product without ?view= and switch the test off for the rest of the visit.
{%- endcomment -%}
{%- if settings.ab_enabled and request.page_type == '404' -%}
  <script>
    (function () {
      var templateA = {{ settings.ab_template_a | default: 'version-a' | strip | json }};
      var url = new URL(window.location.href);

      if (url.searchParams.get('view') === templateA && url.pathname.indexOf('/products/') !== -1) {
        try { sessionStorage.setItem('ab-template-a-missing', '1'); } catch (error) {}
        url.searchParams.delete('view');
        url.searchParams.delete('ab_preview');
        window.location.replace(url.toString());
      }
    })();
  </script>
{%- endif -%}

{%- if settings.ab_enabled and request.page_type == 'product' and product != blank -%}
  {%- liquid
    assign ab_a = settings.ab_template_a | default: 'version-a' | strip
    assign ab_b = settings.ab_template_b | strip
    assign ab_assigned = product.template_suffix | default: ''
    assign ab_current = template.suffix | default: ''

    assign ab_in_test = false
    if ab_a != blank and ab_a != ab_b and ab_assigned == ab_b
      assign ab_in_test = true
    endif
  -%}

  {%- if ab_in_test -%}
    <script>
      (function () {
        var config = {
          a: {{ ab_a | json }},
          current: {{ ab_current | json }},
          start: {{ settings.ab_start | default: '23:30' | strip | json }},
          end: {{ settings.ab_end | default: '01:00' | strip | json }},
          timezone: {{ settings.ab_timezone | strip | json }},
          shopOffset: {{ 'now' | date: '%z' | json }},
          designMode: {{ request.design_mode | json }},
          tagOrders: {{ settings.ab_tag_orders | json }}
        };

        function toMinutes(value, fallback) {
          var match = /^(\d{1,2}):(\d{2})$/.exec(value || '');
          return match ? Math.min(+match[1], 23) * 60 + Math.min(+match[2], 59) : fallback;
        }

        function minutesNow() {
          var now = new Date();

          if (config.timezone) {
            try {
              var hour = 0, minute = 0;
              new Intl.DateTimeFormat('en-US', { timeZone: config.timezone, hourCycle: 'h23', hour: 'numeric', minute: 'numeric' })
                .formatToParts(now)
                .forEach(function (part) {
                  if (part.type === 'hour') hour = parseInt(part.value, 10) % 24;
                  if (part.type === 'minute') minute = parseInt(part.value, 10);
                });
              return hour * 60 + minute;
            } catch (error) {
              // Unknown timezone name: fall back to the store timezone.
            }
          }

          var offset = /^([+-])(\d{2}):?(\d{2})$/.exec(config.shopOffset || '');
          var offsetMinutes = offset ? (offset[1] === '-' ? -1 : 1) * (parseInt(offset[2], 10) * 60 + parseInt(offset[3], 10)) : 0;
          var shifted = new Date(now.getTime() + offsetMinutes * 60000);
          return shifted.getUTCHours() * 60 + shifted.getUTCMinutes();
        }

        var start = toMinutes(config.start, 1410);
        var end = toMinutes(config.end, 60);
        var now = minutesNow();
        var inWindow = start === end ? false : (start < end ? now >= start && now < end : now >= start || now < end);

        var url = new URL(window.location.href);
        var preview = (url.searchParams.get('ab_preview') || '').toLowerCase();
        var wantA = preview === 'a' ? true : (preview === 'b' ? false : inWindow);

        // Template A answered with a 404 earlier in this visit (see the 404 guard below): stay on B.
        try {
          if (preview !== 'a' && sessionStorage.getItem('ab-template-a-missing')) wantA = false;
        } catch (error) {}
        var isA = config.current === config.a;

        if (!config.designMode) {
          if (wantA && !isA && url.searchParams.get('view') !== config.a) {
            // A ?view= already pointing at A while B is rendered means template A does not exist: stay on B.
            url.searchParams.set('view', config.a);
            window.location.replace(url.toString());
            return;
          }

          if (!wantA && isA) {
            url.searchParams.delete('view');
            window.location.replace(url.toString());
            return;
          }
        }

        var version = isA ? 'A' : 'B';
        document.documentElement.setAttribute('data-ab-version', version);

        if (config.tagOrders && !config.designMode) {
          document.addEventListener('DOMContentLoaded', function () {
            try {
              if (sessionStorage.getItem('ab-product-page') === version) return;
            } catch (error) {}

            var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            fetch(root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ attributes: { 'A/B page produit': version } })
            }).then(function (response) {
              if (!response.ok) return;
              try { sessionStorage.setItem('ab-product-page', version); } catch (error) {}
            }).catch(function () {});
          });
        }

        window.addEventListener('load', function () {
          try {
            if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
              window.Shopify.analytics.publish('ab_product_page_view', { version: version, template: config.current || 'default' });
            }
          } catch (error) {}
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}
