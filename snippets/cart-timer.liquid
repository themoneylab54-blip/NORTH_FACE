{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CART TIMER
----------------------------------------------------------------------------------------------------------------------

Bar at the very top of every page while the cart has items (Theme settings > Minuteur panier). The countdown starts at
the first item added and carries on across pages and tabs (end time kept in localStorage). At zero the cart is really
emptied (/cart/clear.js): the bar says what happens, and it happens. The timer stops when the cart becomes empty.
{%- endcomment -%}

{%- if settings.cart_timer_enabled -%}
  <style>
    .cart-timer {
      display: block;
      padding: 8px 16px;
      background: {{ settings.cart_timer_background | default: '#c8102e' }};
      color: {{ settings.cart_timer_text_color | default: '#ffffff' }};
      font-family: var(--text-font-family);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
      text-align: center;
    }

    .cart-timer[hidden] {
      display: none;
    }

    .cart-timer__clock {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }
  </style>

  <cart-timer class="cart-timer" minutes="{{ settings.cart_timer_minutes | default: 5 }}" item-count="{{ cart.item_count }}" {% if request.page_type == 'cart' %}reload-on-expire{% endif %} hidden>
    <p data-cart-timer-running>
      {{- settings.cart_timer_text | default: 'Your cart expires in' | escape }} <span class="cart-timer__clock" data-cart-timer-clock role="timer">{{ settings.cart_timer_minutes | default: 5 | prepend: '0' | slice: -2, 2 }}:00</span>
    </p>
    <p data-cart-timer-expired role="status" hidden>{{ settings.cart_timer_expired_text | default: 'Your cart has expired and was emptied.' | escape }}</p>
  </cart-timer>

  <script>
    if (!window.customElements.get('cart-timer')) {
      window.customElements.define('cart-timer', class extends HTMLElement {
        connectedCallback() {
          this.storageKey = 'cart-timer-expires-at';
          this.minutes = Math.max(1, parseInt(this.getAttribute('minutes'), 10) || 5);
          this.clock = this.querySelector('[data-cart-timer-clock]');
          this.running = this.querySelector('[data-cart-timer-running]');
          this.expired = this.querySelector('[data-cart-timer-expired]');

          this.onCartChange = (event) => this.sync(event.detail?.cart?.item_count ?? 0);
          this.onPageShow = async (event) => {
            if (!event.persisted) return;
            try {
              const cart = await (await fetch(`${this.root}cart.js`)).json();
              this.sync(cart.item_count);
            } catch (error) {}
          };

          document.addEventListener('cart:change', this.onCartChange);
          window.addEventListener('pageshow', this.onPageShow);
          this.sync(parseInt(this.getAttribute('item-count'), 10) || 0);
        }

        disconnectedCallback() {
          document.removeEventListener('cart:change', this.onCartChange);
          window.removeEventListener('pageshow', this.onPageShow);
          clearInterval(this.interval);
        }

        get root() {
          return window.Shopify?.routes?.root || '/';
        }

        read() {
          try {
            return parseInt(window.localStorage.getItem(this.storageKey), 10) || 0;
          } catch (error) {
            return this.memory || 0;
          }
        }

        write(expiresAt) {
          this.memory = expiresAt;
          try {
            if (expiresAt) {
              window.localStorage.setItem(this.storageKey, String(expiresAt));
            } else {
              window.localStorage.removeItem(this.storageKey);
            }
          } catch (error) {}
        }

        sync(itemCount) {
          if (itemCount <= 0) {
            this.write(0);
            this.stop();
            return;
          }

          if (!this.read()) {
            this.write(Date.now() + this.minutes * 60000);
          }

          this.running.hidden = false;
          this.expired.hidden = true;
          this.hidden = false;
          this.tick();
          clearInterval(this.interval);
          this.interval = setInterval(() => this.tick(), 1000);
        }

        stop() {
          clearInterval(this.interval);
          this.hidden = true;
        }

        tick() {
          const expiresAt = this.read();

          // Cleared in another tab (cart emptied or expired there).
          if (!expiresAt) {
            this.stop();
            return;
          }

          const secondsLeft = Math.ceil((expiresAt - Date.now()) / 1000);

          if (secondsLeft <= 0) {
            this.expire();
            return;
          }

          const minutes = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
          const seconds = String(secondsLeft % 60).padStart(2, '0');
          this.clock.textContent = `${minutes}:${seconds}`;
        }

        async expire() {
          clearInterval(this.interval);
          this.write(0);

          try {
            await fetch(`${this.root}cart/clear.js`, { method: 'POST', headers: { 'Accept': 'application/json' } });
          } catch (error) {}

          if (this.hasAttribute('reload-on-expire')) {
            window.location.reload();
            return;
          }

          // Cart count, cart drawer and any cart-aware element refresh from the server.
          document.dispatchEvent(new CustomEvent('cart:refresh'));

          this.running.hidden = true;
          this.expired.hidden = false;
          this.hidden = false;
          setTimeout(() => {
            if (!this.read()) this.hidden = true;
          }, 6000);
        }
      });
    }
  </script>
{%- endif -%}
