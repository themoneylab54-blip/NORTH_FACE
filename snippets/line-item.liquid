{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
LINE ITEM
----------------------------------------------------------------------------------------------------------------------

This component renders a single line item product information, and is used on order and cart page.

********************************************
Supported variables
********************************************

* line_item: the line item to render (required)
* show_desktop_quantity: if set to true (for instance on cart drawer), the quantity is also shown on the line
* show_compare_at: if set to true, the struck price uses the compare at price when it is higher than the regular price
* show_savings: if set to true (cart), a green badge shows the money saved on the line instead of the discount names
{%- endcomment -%}

{% liquid
  assign max_quantity = nil

  if line_item.variant.inventory_management != blank and line_item.variant.inventory_policy == 'deny'
    assign current_quantity_for_variant = cart | item_count_for_variant: line_item.variant.id
    assign max_quantity = line_item.variant.inventory_quantity | minus: current_quantity_for_variant | plus: line_item.quantity
  endif

  if line_item.variant.quantity_rule.max != nil
    assign max_quantity = max_quantity | default: 999999 | at_most: line_item.variant.quantity_rule.max
  endif

  # Money saved on the line, measured against the same struck price as the price list: the price before discounts, or
  # the compare at price times the quantity when show_compare_at is set and it is higher.
  assign line_reference_total = line_item.original_line_price

  if show_compare_at and line_item.variant.compare_at_price > line_item.variant.price
    assign line_compare_total = line_item.variant.compare_at_price | times: line_item.quantity

    if line_compare_total > line_reference_total
      assign line_reference_total = line_compare_total
    endif
  endif

  assign line_savings = line_reference_total | minus: line_item.final_line_price
%}

<line-item class="line-item">
  {%- if line_item.image != blank -%}
    <div class="line-item__media-wrapper">
      {{- line_item.image | image_url: width: line_item.image.width | image_tag: loading: 'lazy', sizes: '(max-width: 740px) 80px, 96px', widths: '80,96,160,192', class: 'line-item__media rounded-xs' -}}

      <pill-loader class="pill-loader"></pill-loader>
    </div>
  {%- endif -%}

  <div class="line-item__info">
    <div class="v-stack gap-0.5">
      {%- if line_item.url != blank -%}
        <a href="{{ line_item.url }}" class="bold">
          <span class="reversed-link hover:show">{{ line_item.product.title | default: line_item.title }}</span>
        </a>
      {%- else -%}
        <p class="bold">{{ line_item.product.title | default: line_item.title }}</p>
      {%- endif -%}

      {%- render 'price-list', line_item: line_item, show_compare_at: show_compare_at -%}
    </div>

    {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
      <p class="text-sm text-subdued">{{ line_item.variant.title }}</p>
    {%- endunless -%}

    {%- if line_item.selling_plan_allocation -%}
      <p class="text-sm text-subdued">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- unless line_item.properties == blank -%}
      <ul class="list-disc">
        {%- for property in line_item.properties -%}
          {%- assign first_character_in_key = property.first | truncate: 1, '' -%}

          {%- if property.last == blank or first_character_in_key == '_' -%}
            {%- continue -%}
          {%- endif -%}

          <li class="text-sm text-subdued">
            {%- if property.last contains '/uploads/' -%}
              <a href="{{ property.last }}" class="link">{{ property.last | split: '/' | last }}</a>
            {%- else -%}
              {{ property.first }}: {{ property.last }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endunless -%}

    {%- if show_savings -%}
      {%- if line_savings > 0 -%}
        <p class="savings-badge">
          {%- render 'icon' with 'discount', width: 12, height: 12 -%}
          {%- assign line_savings_amount = line_savings | money -%}
          <span>{{ 'cart.general.line_savings_html' | t: amount: line_savings_amount }}</span>
        </p>
      {%- endif -%}
    {%- elsif line_item.line_level_discount_allocations != blank -%}
      <ul class="contents" role="list">
        {%- for discount_allocation in line_item.line_level_discount_allocations -%}
          {%- comment -%}An offer spread over several lines lists a $0.00 share on the lines it does not discount{%- endcomment -%}
          {%- if discount_allocation.amount > 0 -%}
            <li class="badge">
              {%- render 'icon' with 'discount' -%} {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="text-sm text-subdued sm:hidden">
      {%- if line_item.url_to_remove -%}
        <line-item-quantity class="h-stack items-center gap-3">
          {%- render 'cart-quantity-stepper', line_item: line_item, max_quantity: max_quantity -%}

          <span class="text-xs">
            <a href="{{ line_item.url_to_remove }}" class="link" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
              {{- 'cart.order.remove' | t -}}
            </a>
          </span>
        </line-item-quantity>
      {%- else -%}
        {{- 'customer.order.quantity' | t }}: {{ line_item.quantity -}}
      {%- endif -%}
    </div>

    {%- if extras != blank -%}
      <div class="cart-line-extras">{{ extras }}</div>
    {%- endif -%}
  </div>

  {%- if show_desktop_quantity -%}
    <div class="line-item__actions text-subdued hidden sm:block">
      <line-item-quantity class="v-stack justify-items-center gap-2">
        {%- render 'cart-quantity-stepper', line_item: line_item, max_quantity: max_quantity -%}

        <span class="text-xs text-center">
          <a href="{{ line_item.url_to_remove }}" class="link" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
            {{- 'cart.order.remove' | t -}}
          </a>
        </span>
      </line-item-quantity>
    </div>
  {%- endif -%}
</line-item>