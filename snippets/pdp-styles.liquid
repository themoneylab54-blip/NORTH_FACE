{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PDP STYLES (internal, not a merchant-facing block)
----------------------------------------------------------------------------------------------------------------------

CSS bundle rendered ONCE inside the product-info column. It restyles the theme-native pieces of the product page
(title, add-to-cart button, collapsible_text accordions, block spacing) to the reference measurements, and exposes two
small utilities (.pdp-label, .pdp-chip) that the other pdp-* snippets reuse.

Everything is scoped under #shopify-section-{{ section.id }} so it cannot leak into other sections.

Supported variables:
* section: the current section (required, used for scoping)
{%- endcomment -%}

{%- assign pdp_scope = '#shopify-section-' | append: section.id -%}

<style>
  {{ pdp_scope }} {
    /* Reference design tokens (measured on the reference product page) */
    --pdp-bg: #FFFFFF;
    --pdp-text: #111111;
    --pdp-muted-bg: #F4F3F0;
    --pdp-muted-text: #6E6E6E;
    --pdp-border: #E4E2DD;
    --pdp-input-border: #D9D9D6;
    --pdp-cta: #111111;
    --pdp-cta-text: #FFFFFF;
    --pdp-sale: #C8102E;
    --pdp-sale-text: #FFFFFF;
    --pdp-tier: #C8102E;
    --pdp-verified: #1E6B45;
    --pdp-radius: 2px;
    --pdp-radius-card: 4px;
    --pdp-radius-badge: 2px;
    --pdp-shadow-card: none;
    --pdp-font: var(--text-font-family), -apple-system, "Segoe UI", sans-serif;
    --pdp-heading-font: var(--heading-font-family), var(--text-font-family), sans-serif;
  }

  /* ------------------------------------------------------------------
     Column: theme text font everywhere, 14px gap between blocks
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .product-info {
    --product-info-block-spacing: 14px;
    font-family: var(--pdp-font);
    color: var(--pdp-text);
  }

  {{ pdp_scope }} .product-info__block-item:where([data-block-type="vendor"], [data-block-type="title"], [data-block-type="sku"], [data-block-type="price"], [data-block-type="rating"], [data-block-type="payment-terms"]) {
    --product-info-block-spacing: 8px;
  }

  {{ pdp_scope }} .product-info__block-item:where([data-block-type="badges"]),
  {{ pdp_scope }} .product-info__block-item:where([data-block-type="buy-buttons"]) {
    --product-info-block-spacing: 14px;
  }

  @media screen and (min-width: 700px) {
    {{ pdp_scope }} .product-info__block-item:where([data-block-type="vendor"], [data-block-type="title"], [data-block-type="sku"], [data-block-type="price"], [data-block-type="rating"], [data-block-type="payment-terms"]) {
      --product-info-block-spacing: 8px;
    }

    {{ pdp_scope }} .product-info__block-item:where([data-block-type="buy-buttons"]) {
      --product-info-block-spacing: 14px;
    }
  }

  /* ------------------------------------------------------------------
     Title: heading font, 26px 700, uppercase, light tracking (outdoor premium look)
     ------------------------------------------------------------------ */
  {{ pdp_scope }} h1.product-info__title,
  {{ pdp_scope }} .product-info__title {
    font-family: var(--pdp-heading-font);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: var(--pdp-text);
    margin: 0;
  }

  /* ------------------------------------------------------------------
     Add to cart: black rectangle, 58px tall, full width, uppercase
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .product-info__buy-buttons .buy-buttons {
    grid-template-columns: minmax(0, 1fr);
  }

  {{ pdp_scope }} .product-info__buy-buttons .button,
  {{ pdp_scope }} .product-info__buy-buttons [type="submit"] {
    --button-background: 17 17 17 / 1;
    --button-text-color: 255 255 255;
    --button-outline-color: 17 17 17;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 58px;
    height: 58px;
    padding-block: 0;
    padding-inline: 24px;
    border: 0;
    border-radius: var(--pdp-radius);
    background-color: var(--pdp-cta);
    color: var(--pdp-cta-text);
    font-family: var(--pdp-font);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .08em;
    text-transform: uppercase;
    box-shadow: none;
    transition: filter .15s ease-in-out, background-color .15s ease-in-out, color .15s ease-in-out;
  }

  {{ pdp_scope }} .product-info__buy-buttons .button[disabled],
  {{ pdp_scope }} .product-info__buy-buttons [type="submit"][disabled] {
    background-color: var(--pdp-muted-bg);
    color: var(--pdp-muted-text);
    cursor: not-allowed;
  }

  @media screen and (pointer: fine) {
    {{ pdp_scope }} .product-info__buy-buttons .button:not([disabled]):hover,
    {{ pdp_scope }} .product-info__buy-buttons [type="submit"]:not([disabled]):hover {
      background-color: #333333;
      box-shadow: none;
    }
  }

  /* The theme's loader/feedback layers are absolutely positioned inside the button: keep them centred in the pill */
  {{ pdp_scope }} .product-info__buy-buttons .button .button__loader,
  {{ pdp_scope }} .product-info__buy-buttons .button .button__feedback {
    border-radius: var(--pdp-radius);
  }

  /* Dynamic checkout button (if enabled): match the button shape only, keep its own colours */
  {{ pdp_scope }} .product-info__buy-buttons .shopify-payment-button__button--unbranded {
    border-radius: var(--pdp-radius) !important;
    min-height: 58px;
    font-family: var(--pdp-font) !important;
    font-weight: 500 !important;
    font-size: 16px !important;
  }

  /* ------------------------------------------------------------------
     collapsible_text accordions: 16px, thin bottom border, "+" / "–" marker
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .product-info__accordion {
    --accordion-spacing: 16px;
    border-block-start-width: 0;
    border-block-end: 1px solid var(--pdp-border);
    font-family: var(--pdp-font);
    font-size: 16px;
    color: var(--pdp-text);
  }

  {{ pdp_scope }} .product-info__accordion .accordion__toggle {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    gap: 12px;
  }

  {{ pdp_scope }} .product-info__accordion .accordion__toggle .h6 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  {{ pdp_scope }} .product-info__accordion .accordion__content {
    font-size: 15px;
    line-height: 1.6;
    color: var(--pdp-text);
    padding-inline-end: 32px;
    transform: none;
  }

  {{ pdp_scope }} .product-info__accordion .circle-chevron {
    width: 20px;
    height: 20px;
    background: transparent !important;
    color: var(--pdp-text) !important;
    transform: none !important;
    transition: none;
    position: relative;
  }

  {{ pdp_scope }} .product-info__accordion .circle-chevron svg {
    display: none;
  }

  {{ pdp_scope }} .product-info__accordion .circle-chevron::before {
    content: "+";
    font-family: var(--pdp-font);
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    display: block;
  }

  {{ pdp_scope }} .product-info__accordion[open] .circle-chevron::before,
  {{ pdp_scope }} .product-info__accordion[aria-expanded="true"] .circle-chevron::before {
    content: "\2013";
  }

  {{ pdp_scope }} .product-info__accordion summary {
    cursor: pointer;
    list-style: none;
  }

  {{ pdp_scope }} .product-info__accordion summary::-webkit-details-marker {
    display: none;
  }

  {{ pdp_scope }} .product-info__accordion .prose {
    font-family: var(--pdp-font);
  }

  /* ------------------------------------------------------------------
     Utilities reused by the other pdp-* snippets
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .pdp-label {
    display: block;
    font-family: var(--pdp-font);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--pdp-text);
  }

  {{ pdp_scope }} .pdp-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--pdp-font);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--pdp-muted-bg);
    color: var(--pdp-text);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------------
     Color chips (outdoor brand style): small 46 x 32 rectangles in one
     row, thin frame, black outline around the selected color
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .pdp-size-selector__values--color,
  {{ pdp_scope }} .variant-picker__option-values:has(.thumbnail-swatch) {
    gap: 6px;
  }

  {{ pdp_scope }} .pdp-size-selector__values--color :is(.thumbnail-swatch, .color-swatch),
  {{ pdp_scope }} .variant-picker__option-values .thumbnail-swatch {
    --swatch-size: 46px;
    width: 46px;
    height: 32px;
    margin: 0;
    border-radius: var(--pdp-radius);
    outline: 1px solid var(--pdp-border);
    outline-offset: -1px;
    cursor: pointer;
  }

  {{ pdp_scope }} :is(.pdp-size-selector__values--color, .variant-picker__option-values) .thumbnail-swatch > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--pdp-radius);
  }

  {{ pdp_scope }} .pdp-size-selector__values--color :is(.thumbnail-swatch, .color-swatch)::before,
  {{ pdp_scope }} .variant-picker__option-values .thumbnail-swatch::before {
    inset: -4px;
    width: auto;
    border-radius: 3px;
    box-shadow: 0 0 0 1px var(--pdp-text);
    transform: none;
  }

  {{ pdp_scope }} :checked + :is(.thumbnail-swatch, .color-swatch) {
    outline-color: transparent;
  }

  /* Two-tone color chips (diagonal main color / second color, set in the theme's color swatch configuration):
     40 x 30, no frame, a thin dark ring 3px around the selected one. Sold out: faded, without the strike line
     that would read as a third color across the diagonal. */
  {{ pdp_scope }} .pdp-size-selector__values--color {
    gap: 8px;
  }

  {{ pdp_scope }} .pdp-size-selector__values--color .color-swatch {
    width: 40px;
    height: 30px;
    border-radius: 3px;
    outline: none;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / .08);
  }

  {{ pdp_scope }} .pdp-size-selector__values--color .color-swatch::before {
    inset: -4px;
    border-radius: 5px;
    box-shadow: 0 0 0 1.5px #111111;
  }

  {{ pdp_scope }} .pdp-size-selector__values--color .color-swatch.is-disabled {
    background: var(--swatch-background) center / cover;
    opacity: .35;
  }

  /* ------------------------------------------------------------------
     Mobile gallery arrows: two small squares over the bottom-left corner
     ------------------------------------------------------------------ */
  {{ pdp_scope }} .product-gallery__arrows {
    position: absolute;
    inset-inline-start: 12px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }

  {{ pdp_scope }} .product-gallery__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--pdp-input-border);
    border-radius: var(--pdp-radius);
    background: rgba(255, 255, 255, .92);
    color: var(--pdp-text);
    cursor: pointer;
  }

  {{ pdp_scope }} .product-gallery__arrow svg {
    width: 10px;
    height: auto;
  }
</style>
